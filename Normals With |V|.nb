           RowBox[{RowBox[{"{", RowBox[{"positions", ",", "times", ",",
                 "direction", ",", "centerX", ",", "centerY", ",", "centerZ",
                 ",", "centerVector", ",", "speed", ",", "speedValue", ",",
                 "equations", ",", "solutions", ",", "physicalSolutions",
                 ",", "solution", ",", "centerValue", ",", "sigma", ",",
                 "normal", ",", "residuals"}], "}"}], ",",
             RowBox[{RowBox[{"positions", "=", RowBox[{"Partition", "[",
                   RowBox[{RowBox[{"Lookup", "[", RowBox[{"data", ",",
                         RowBox[{"Flatten", "[", "coordinateSymbols",
                          "]"}]}], "]"}], ",", "3"}], "]"}]}], ";", RowBox[
                {"times", "=", RowBox[{"Prepend", "[", RowBox[
                    {RowBox[{"Lookup", "[", RowBox[{"data", ",",
                         "relativeTimeSymbols"}], "]"}], ",", "0.`"}],
                   "]"}]}], ";", RowBox[{"direction", "=", RowBox[{"Lookup",
                   "[", RowBox[{"data", ",", RowBox[{"{", RowBox[{"vXN", ",",
                         "vYN", ",", "vZN"}], "}"}]}], "]"}]}], ";", RowBox[
                {"centerVector", "=", RowBox[{"{", RowBox[{"centerX", ",",
                     "centerY", ",", "centerZ"}], "}"}]}], ";", RowBox[
                {"equations", "=", RowBox[{"Table", "[", RowBox[
                    {RowBox[{RowBox[{"Total", "[", SuperscriptBox[RowBox[
                          {"(", RowBox[{RowBox[{"positions",
                          "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], "-", "centerVector",
                          "-", RowBox[{"speed", " ", RowBox[{"times",
                          "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], " ", "direction"}]}],
                          ")"}], "2"], "]"}], "\[Equal]", RowBox[{"Total",
                         "[", SuperscriptBox[RowBox[{"(", RowBox[{RowBox[
                          {"First", "[", "positions", "]"}], "-",
                          "centerVector"}], ")"}], "2"], "]"}]}], ",",
                     RowBox[{"{", RowBox[{"i", ",", "2", ",", "5"}], "}"}]}],
                   "]"}]}], ";", RowBox[{"solutions", "=", RowBox[{"NSolve",
                   "[", RowBox[{"equations", ",", RowBox[{"{", RowBox[
                        {"centerX", ",", "centerY", ",", "centerZ", ",",
                         "speed"}], "}"}], ",", TemplateBox[{}, "Reals"]}],
                   "]"}]}], ";", RowBox[{"physicalSolutions", "=",
