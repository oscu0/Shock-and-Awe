Cell[CellGroupData[{Cell["Testing", "Section", ExpressionUUID ->
     "9c3fad27-7859-4ca3-bae9-955b8d79ddec"], Cell["The planar solution uses \
the first four crossings; the spherical solution uses all five. Normals are \
oriented so that their dot product with the supplied propagation direction is \
positive.", "Text", ExpressionUUID ->
     "06e38834-caec-4bb3-a95f-58e2c144f634"],
   Cell[BoxData[RowBox[{RowBox[{"earthRadiusKm", "=", "6378.`"}], ";",
       RowBox[{"ClearAll", "[", "solvePlanarShock", "]"}], ";",
       RowBox[{StyleBox[RowBox[{"solvePlanarShock", "::", "degenerate"}],
          "MessageName"], "=",
         "\"The first four crossings do not define a unique moving plane.\""}]\
, ";", RowBox[{StyleBox[RowBox[{"solvePlanarShock", "::", "direction"}],
          "MessageName"], "=", "\"The plane solution moves opposite to the \
supplied propagation direction.\""}], ";",
       RowBox[{RowBox[{"solvePlanarShock", "[", "data_Association", "]"}],
         ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                {"positions", ",", "times", ",", "direction", ",",
                 "displacements", ",", "denominator", ",", "speed", ",",
                 "correctedDisplacements", ",", "normal", ",", "residuals"}],
               "}"}], ",", RowBox[{RowBox[{"positions", "=", RowBox[
                  {"Partition", "[", RowBox[{RowBox[{"Lookup", "[", RowBox[
                        {"data", ",", RowBox[{"Flatten", "[",
                          "coordinateSymbols", "]"}]}], "]"}], ",", "3"}],
                   "]"}]}], ";", RowBox[{"times", "=", RowBox[{"Prepend",
                   "[", RowBox[{RowBox[{"Lookup", "[", RowBox[{"data", ",",
                         "relativeTimeSymbols"}], "]"}], ",", "0.`"}],
                   "]"}]}], ";", RowBox[{"direction", "=", RowBox[{"Lookup",
                   "[", RowBox[{"data", ",", RowBox[{"{", RowBox[{"vXN", ",",
                         "vYN", ",", "vZN"}], "}"}]}], "]"}]}], ";", RowBox[
                {"displacements", "=", RowBox[{RowBox[{"(", RowBox[
                      {RowBox[{"#1", "-", RowBox[{"First", "[", "positions",
                          "]"}]}], "&"}], ")"}], "/@", RowBox[{"positions",
                     "\[LeftDoubleBracket]", RowBox[{"2", ";;", "4"}],
                     "\[RightDoubleBracket]"}]}]}], ";", RowBox[
                {"denominator", "=", RowBox[{UnderoverscriptBox["\[Sum]",
                    "i", "3"], RowBox[{RowBox[{"times",
                       "\[LeftDoubleBracket]", RowBox[{"i", "+", "1"}],
                       "\[RightDoubleBracket]"}], " ", RowBox[{"Det", "[",
                       RowBox[{"ReplacePart", "[", RowBox[{"displacements",
                          ",", RowBox[{"i", "\[Rule]", "direction"}]}],
                         "]"}], "]"}]}]}]}], ";", RowBox[{"If", "[",
                 RowBox[{RowBox[{RowBox[{"Abs", "[", "denominator", "]"}],
                     "<", FractionBox["1", SuperscriptBox["10", "12"]]}],
                   ",", RowBox[{RowBox[{"Message", "[", StyleBox[RowBox[
                         {"solvePlanarShock", "::", "degenerate"}],
                        "MessageName"], "]"}], ";", RowBox[{"Return", "[",
                       "$Failed", "]"}]}]}], "]"}], ";", RowBox[{"speed",
                 "=", FractionBox[RowBox[{"Det", "[", "displacements", "]"}],
                  "denominator"]}], ";", RowBox[{"If", "[", RowBox[
                  {RowBox[{"speed", "\[LessEqual]", "0"}], ",", RowBox[
                    {RowBox[{"Message", "[", StyleBox[RowBox[
                         {"solvePlanarShock", "::", "direction"}],
                        "MessageName"], "]"}], ";", RowBox[{"Return", "[",
                       "$Failed", "]"}]}]}], "]"}], ";", RowBox[
                {"correctedDisplacements", "=", RowBox[{"MapThread", "[",
                   RowBox[{RowBox[{RowBox[{"#1", "-", RowBox[{"speed", " ",
                          "#2", " ", "direction"}]}], "&"}], ",", RowBox[
                      {"{", RowBox[{"displacements", ",", RowBox[{"times",
                          "\[LeftDoubleBracket]", RowBox[{"2", ";;", "4"}],
                          "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], ";",
               RowBox[{"normal", "=", RowBox[{"Normalize", "[", RowBox[
                    {RowBox[{"correctedDisplacements",
                       "\[LeftDoubleBracket]", "1",
                       "\[RightDoubleBracket]"}], "\[Cross]", RowBox[
                      {"correctedDisplacements", "\[LeftDoubleBracket]", "2",
                       "\[RightDoubleBracket]"}]}], "]"}]}], ";", RowBox[
                {"If", "[", RowBox[{RowBox[{RowBox[{"normal", ".",
                       "direction"}], "<", "0"}], ",", RowBox[{"normal", "=",
                     RowBox[{"-", "normal"}]}]}], "]"}], ";", RowBox[
                {"residuals", "=", RowBox[{"Abs", "[", RowBox[
                    {"correctedDisplacements", ".", "normal"}], "]"}]}], ";",
               RowBox[{"Association", "[", RowBox[{RowBox[
                    {"\"speedREPerSecond\"", "\[Rule]", RowBox[{"N", "[",
