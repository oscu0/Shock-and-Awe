      {"\"\<5-satellite sphere\>\"", "\"\<A-E\>\"", "sphereSpeedData", 
       RowBox[{"earthRadiusKm", " ", "sphereSpeedData"}], "sphereNormalData"}
     },
     AutoDelete->False,
