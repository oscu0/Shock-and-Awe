Cell[CellGroupData[{Cell["Interface", "Section",
    ExpressionUUID -> "fa70cd3e-00a3-463f-b254-5b341defbd6c"],
   Cell["Load the crossing catalogue and map five selected spacecraft, in \
crossing order, into the symbolic solver variables.", "Text",
    ExpressionUUID -> "8276d202-f16f-4f40-be85-8259418d7473"],
   Cell[BoxData[RowBox[{RowBox[{"shockParamsPath", "=",
         RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[
              {RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"Shocks\"",
               ",", "\"Shock Params.json\""}], "}"}], "]"}]}], ";",
       RowBox[{"shockParams", "=", RowBox[{"Import", "[",
           RowBox[{"shockParamsPath", ",", "\"RawJSON\""}], "]"}]}], ";"}]],
    "Input", ExpressionUUID -> "76b5af9a-9d8c-4d46-a4e1-4226a14b5be1"],
   Cell[BoxData[RowBox[{RowBox[{"coordinateSymbols", "=",
         RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"aX", ",", "aY", ",",
                 "aZ"}], "}"}], ",", RowBox[{"{", RowBox[{"bX", ",", "bY",
                 ",", "bZ"}], "}"}], ",", RowBox[{"{", RowBox[{"cX", ",",
                 "cY", ",", "cZ"}], "}"}], ",", RowBox[{"{", RowBox[
                {"dX", ",", "dY", ",", "dZ"}], "}"}], ",",
             RowBox[{"{", RowBox[{"eX", ",", "eY", ",", "eZ"}], "}"}]}],
           "}"}]}], ";", RowBox[{"relativeTimeSymbols", "=",
         RowBox[{"{", RowBox[{"tAB", ",", "tAC", ",", "tAD", ",", "tAE"}],
           "}"}]}], ";", RowBox[{"ClearAll", "[", "toSolverData", "]"}], ";",
       RowBox[{StyleBox[RowBox[{"toSolverData", "::", "event"}],
          "MessageName"], "=",
         "\"Event `1` is not present in the shock catalogue.\""}], ";",
       RowBox[{StyleBox[RowBox[{"toSolverData", "::", "selection"}],
          "MessageName"], "=",
         "\"Select exactly five distinct satellites in crossing order.\""}],
       ";", RowBox[{StyleBox[RowBox[{"toSolverData", "::", "satellite"}],
          "MessageName"], "=", "\"Event `1` has no record for: `2`.\""}],
       ";", RowBox[{StyleBox[RowBox[{"toSolverData", "::", "position"}],
          "MessageName"], "=", "\"Every selected satellite must have a \
numeric three-component position.\""}], ";",
       RowBox[{StyleBox[RowBox[{"toSolverData", "::", "frame"}],
          "MessageName"], "=", "\"Every selected position must use Cartesian \
GSE coordinates in R_E.\""}], ";",
       RowBox[{StyleBox[RowBox[{"toSolverData", "::", "order"}],
          "MessageName"], "=", "\"The selected satellites' crossing times \
must be strictly increasing.\""}], ";",
       RowBox[{StyleBox[RowBox[{"toSolverData", "::", "velocity"}],
          "MessageName"], "=", "\"The propagation vector must be a nonzero \
numeric three-vector.\""}], ";", RowBox[
        {RowBox[{"toSolverData", "[", RowBox[{"eventKey_String", ",",
             "satellites_List", ",", "velocityGSE_List"}], "]"}], ":=",
         RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"event", ",",
                 "missingSatellites", ",", "entries", ",", "positionRecords",
                 ",", "positions", ",", "crossingTimes", ",",
                 "relativeTimes", ",", "direction"}], "}"}], ",",
             RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[
                      {"KeyExistsQ", "[", RowBox[{"shockParams", ",",
                         "eventKey"}], "]"}]}], ",", RowBox[{RowBox[
                      {"Message", "[", RowBox[{StyleBox[RowBox[
                          {"toSolverData", "::", "event"}], "MessageName"],
                         ",", "eventKey"}], "]"}], ";", RowBox[{"Return",
                       "[", "$Failed", "]"}]}]}], "]"}], ";", RowBox[
                {"If", "[", RowBox[{RowBox[{RowBox[{RowBox[{"Length", "[",
                         "satellites", "]"}], "\[NotEqual]", "5"}], "||",
                     RowBox[{"!", RowBox[{"DuplicateFreeQ", "[",
                         "satellites", "]"}]}]}], ",", RowBox[
                    {RowBox[{"Message", "[", StyleBox[RowBox[{"toSolverData",
                          "::", "selection"}], "MessageName"], "]"}], ";",
                     RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";",
               RowBox[{"event", "=", RowBox[{"Lookup", "[", RowBox[
                    {"shockParams", ",", "eventKey"}], "]"}]}], ";", RowBox[
                {"missingSatellites", "=", RowBox[{"Select", "[",
                   RowBox[{"satellites", ",", RowBox[{RowBox[{"!", RowBox[
                          {"KeyExistsQ", "[", RowBox[{"event", ",", "#1"}],
                          "]"}]}], "&"}]}], "]"}]}], ";", RowBox[
                {"If", "[", RowBox[{RowBox[{"missingSatellites", "=!=",
                     RowBox[{"{", "}"}]}], ",", RowBox[{RowBox[{"Message",
                       "[", RowBox[{StyleBox[RowBox[{"toSolverData", "::",
                          "satellite"}], "MessageName"], ",", "eventKey",
                         ",", "missingSatellites"}], "]"}], ";", RowBox[
                      {"Return", "[", "$Failed", "]"}]}]}], "]"}], ";",
               RowBox[{"entries", "=", RowBox[{"Lookup", "[", RowBox[
                    {"event", ",", "satellites"}], "]"}]}], ";", RowBox[
                {"positionRecords", "=", RowBox[{RowBox[{"(", RowBox[
                      {RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                          "\"position\"", ",", RowBox[{"Missing", "[",
                          "\"Position\"", "]"}]}], "]"}], "&"}], ")"}], "/@",
                   "entries"}]}], ";", RowBox[{"If", "[", RowBox[
                  {RowBox[{"!", RowBox[{"AllTrue", "[", RowBox[
                        {"positionRecords", ",", "AssociationQ"}], "]"}]}],
                   ",", RowBox[{RowBox[{"Message", "[", StyleBox[RowBox[
                         {"toSolverData", "::", "position"}], "MessageName"],
                       "]"}], ";", RowBox[{"Return", "[", "$Failed",
                       "]"}]}]}], "]"}], ";", RowBox[{"If", "[",
                 RowBox[{RowBox[{"!", RowBox[{"AllTrue", "[", RowBox[
                        {"positionRecords", ",", RowBox[{RowBox[{RowBox[
                          {RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                          "\"frame\"", ",", RowBox[{"Missing", "[",
                          "\"Frame\"", "]"}]}], "]"}], "===", "\"GSE\""}],
                          "&&", RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1",
                          ",", "\"units\"", ",", RowBox[{"Missing", "[",
                          "\"Units\"", "]"}]}], "]"}], "===", "\"R_E\""}]}],
                          "&"}]}], "]"}]}], ",", RowBox[{RowBox[{"Message",
                       "[", StyleBox[RowBox[{"toSolverData", "::", "frame"}],
                        "MessageName"], "]"}], ";", RowBox[{"Return", "[",
                       "$Failed", "]"}]}]}], "]"}], ";", RowBox[{"positions",
                 "=", RowBox[{"N", "[", RowBox[{RowBox[{"(", RowBox[
                        {RowBox[{"Lookup", "[", RowBox[{"#1", ",", RowBox[
                          {"{", RowBox[{"\"x\"", ",", "\"y\"", ",",
                          "\"z\""}], "}"}]}], "]"}], "&"}], ")"}], "/@",
                     "positionRecords"}], "]"}]}], ";", RowBox[{"If", "[",
                 RowBox[{RowBox[{RowBox[{RowBox[{"Dimensions", "[",
                         "positions", "]"}], "=!=", RowBox[{"{", RowBox[
                          {"5", ",", "3"}], "}"}]}], "||", RowBox[{"!",
                       RowBox[{"MatrixQ", "[", RowBox[{"positions", ",",
                          "NumericQ"}], "]"}]}]}], ",", RowBox[
                    {RowBox[{"Message", "[", StyleBox[RowBox[{"toSolverData",
                          "::", "position"}], "MessageName"], "]"}], ";",
                     RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";",
               RowBox[{"crossingTimes", "=", RowBox[{RowBox[{"(", RowBox[
                      {RowBox[{"AbsoluteTime", "[", RowBox[{"DateObject",
                          "[", RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1",
                          ",", "\"t0\""}], "]"}], ",", RowBox[{"TimeZone",
                          "\[Rule]", "0"}]}], "]"}], "]"}], "&"}], ")"}],
                   "/@", "entries"}]}], ";", RowBox[{"If", "[",
                 RowBox[{RowBox[{"!", RowBox[{"AllTrue", "[", RowBox[
                        {RowBox[{"Differences", "[", "crossingTimes", "]"}],
                         ",", RowBox[{RowBox[{"#1", ">", "0"}], "&"}]}],
                       "]"}]}], ",", RowBox[{RowBox[{"Message", "[",
                       StyleBox[RowBox[{"toSolverData", "::", "order"}],
                        "MessageName"], "]"}], ";", RowBox[{"Return", "[",
                       "$Failed", "]"}]}]}], "]"}], ";", RowBox[
                {"relativeTimes", "=", RowBox[{"Round", "[", RowBox[
                    {RowBox[{"N", "[", RowBox[{RowBox[{"Rest", "[",
                          "crossingTimes", "]"}], "-", RowBox[{"First", "[",
                          "crossingTimes", "]"}]}], "]"}], ",", FractionBox[
                      "1", SuperscriptBox["10", "6"]]}], "]"}]}], ";", RowBox[
                {"If", "[", RowBox[{RowBox[{RowBox[{"!", RowBox[{"VectorQ",
                         "[", RowBox[{"velocityGSE", ",", "NumericQ"}],
                         "]"}]}], "||", RowBox[{TemplateBox[{RowBox[{"N",
                          "[", "velocityGSE", "]"}]}, "Norm"], "\[Equal]",
                       "0"}]}], ",", RowBox[{RowBox[{"Message", "[",
                       StyleBox[RowBox[{"toSolverData", "::", "velocity"}],
                        "MessageName"], "]"}], ";", RowBox[{"Return", "[",
                       "$Failed", "]"}]}]}], "]"}], ";", RowBox[{"direction",
                 "=", RowBox[{"Normalize", "[", RowBox[{"N", "[",
                     "velocityGSE", "]"}], "]"}]}], ";", RowBox[{"Join", "[",
                 RowBox[{RowBox[{"AssociationThread", "[", RowBox[
                      {RowBox[{"Flatten", "[", "coordinateSymbols", "]"}],
                       ",", RowBox[{"Flatten", "[", "positions", "]"}]}],
                     "]"}], ",", RowBox[{"AssociationThread", "[", RowBox[
                      {"relativeTimeSymbols", ",", "relativeTimes"}], "]"}],
                   ",", RowBox[{"AssociationThread", "[", RowBox[
                      {RowBox[{"{", RowBox[{"vXN", ",", "vYN", ",", "vZN"}],
                         "}"}], ",", "direction"}], "]"}]}], "]"}]}]}],
           "]"}]}], ";"}]], "Input", ExpressionUUID ->
     "c49eefa1-4f12-4cf4-916b-be481eea443f"]}, Open]],

