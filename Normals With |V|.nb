                          {"(", RowBox[{RowBox[{"positions",
                          "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], "-", "centerValue", "-",
                          RowBox[{"speedValue", " ", RowBox[{"times",
                          "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], " ", "direction"}]}],
                          ")"}], "2"], "]"}], "-", "sigma"}], ",", RowBox[
                        {"{", RowBox[{"i", ",", "5"}], "}"}]}], "]"}],
                   "]"}]}], ";", RowBox[{"Association", "[", RowBox[
                  {RowBox[{"\"speedREPerSecond\"", "\[Rule]", "speedValue"}],
