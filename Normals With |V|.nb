                      {"N", "[", RowBox[{"earthRadiusKm", " ",
                         "speedValue"}], "]"}]}], ",", RowBox[
                    {"\"centerAtReferenceRE\"", "\[Rule]", "centerValue"}],
                   ",", RowBox[{"\"sigmaRE2\"", "\[Rule]", "sigma"}], ",",
                   RowBox[{"\"radiusRE\"", "\[Rule]", RowBox[{"N", "[",
                       SqrtBox["sigma"], "]"}]}], ",", RowBox[
                    {"\"normalGSE\"", "\[Rule]", RowBox[{"N", "[", "normal",
                       "]"}]}], ",", RowBox[
                    {"\"maxSquaredDistanceResidualRE2\"", "\[Rule]",
                     RowBox[{"N", "[", RowBox[{"Max", "[", "residuals",
                         "]"}], "]"}]}]}], "]"}]}]}], "]"}]}], ";"}]],
