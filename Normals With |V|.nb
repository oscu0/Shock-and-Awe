    "realSphereCandidate", "\[LeftDoubleBracket]", "4", 
     "\[RightDoubleBracket]"}], "]"}]}], ";", 
  RowBox[{"aPositionData", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aX", ",", "aY", ",", "aZ"}], "}"}], "/.", "\[VeryThinSpace]", 
     "data"}], "]"}]}], ";", 
  RowBox[{"sphereNormalData", "=", 
   RowBox[{"Normalize", "[", 
    RowBox[{"aPositionData", "-", "sphereCenterData"}], "]"}]}], ";", 
  RowBox[{"sphereNormalData", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sphereNormalData", ".", "propagationDirectionData"}], "<", 
      "0"}], ",", 
     RowBox[{"-", "sphereNormalData"}], ",", "sphereNormalData"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"bf1bea55-b008-46b9-97e1-10e6cc996c5c"],

