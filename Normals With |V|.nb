                     "\[VeryThinSpace]", "solution"}], "]"}]}], ";", RowBox[
                {"sigma", "=", RowBox[{"N", "[", RowBox[{"Total", "[",
                     SuperscriptBox[RowBox[{"(", RowBox[{RowBox[{"First",
                          "[", "positions", "]"}], "-", "centerValue"}],
                        ")"}], "2"], "]"}], "]"}]}], ";", RowBox[
                {"normal", "=", RowBox[{"Normalize", "[", RowBox[
                    {RowBox[{"First", "[", "positions", "]"}], "-",
                     "centerValue"}], "]"}]}], ";", RowBox[{"If", "[",
                 RowBox[{RowBox[{RowBox[{"normal", ".", "direction"}], "<",
                     "0"}], ",", RowBox[{"normal", "=", RowBox[{"-",
                       "normal"}]}]}], "]"}], ";", RowBox[{"residuals", "=",
