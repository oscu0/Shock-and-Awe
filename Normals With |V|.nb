Cell[CellGroupData[{

Cell["Plane and Sphere Comparison", "Subsection",ExpressionUUID->"4f4d5927-578b-4ab5-8aee-0724dd180cd8"],

Cell["\<\
The plane uses crossings A-D.  The sphere uses A-E.  Both normals are \
reported at the reference crossing A and oriented toward the supplied \
propagation direction.\
\>", "Text",ExpressionUUID->"991bf8c1-91ac-46e4-8fcc-7b4e5d310915"],

Cell[BoxData[
 RowBox[{
  RowBox[{"propagationDirectionData", "=", 
   RowBox[{"Normalize", "[", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vXN", ",", "vYN", ",", "vZN"}], "}"}], "/.", 
      "\[VeryThinSpace]", "data"}], "]"}], "]"}]}], ";", 
  RowBox[{"planeCandidates", "=", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"planeEqs1", ",", 
        RowBox[{"{", "planeUnitEq", "}"}]}], "]"}], "/.", "\[VeryThinSpace]", 
      "data"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Nu]", ",", "nX", ",", "nY", ",", "nZ"}], "}"}], ",", 
     TemplateBox[{},
      "Reals"]}], "]"}]}], ";", 
  RowBox[{"planeSolution", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Select", "[", 
     RowBox[{"planeCandidates", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Nu]", "/.", "\[VeryThinSpace]", "#1"}], ")"}], ">", 
         "0"}], "&&", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"nX", ",", "nY", ",", "nZ"}], "}"}], "/.", 
            "\[VeryThinSpace]", "#1"}], ")"}], ".", 
          "propagationDirectionData"}], ">", "0"}]}], "&"}]}], "]"}], "]"}]}],
   ";", 
  RowBox[{"planeSpeedData", "=", 
   RowBox[{"N", "[", 
    RowBox[{"\[Nu]", "/.", "\[VeryThinSpace]", "planeSolution"}], "]"}]}], ";", 
  RowBox[{"planeNormalData", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nX", ",", "nY", ",", "nZ"}], "}"}], "/.", "\[VeryThinSpace]", 
     "planeSolution"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"b3df912f-1420-41f4-a2fc-78d488e7dafa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"realSphereCandidate", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Select", "[", 
     RowBox[{"candidateTable", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{"Im", "[", 
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}],
          "]"}], "\[Equal]", "0"}], "&"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"sphereSpeedData", "=", 
   RowBox[{"Re", "[", 
    RowBox[{
    "realSphereCandidate", "\[LeftDoubleBracket]", "1", 
     "\[RightDoubleBracket]"}], "]"}]}], ";", 
  RowBox[{"sphereCenterData", "=", 
   RowBox[{"Re", "[", 
    RowBox[{
    "realSphereCandidate", "\[LeftDoubleBracket]", "2", 
     "\[RightDoubleBracket]"}], "]"}]}], ";", 
  RowBox[{"sphereRadiusData", "=", 
   RowBox[{"Re", "[", 
    RowBox[{
    "realSphereCandidate", "\[LeftDoubleBracket]", "4", 
     "\[RightDoubleBracket]"}], "]"}]}], ";", 
  RowBox[{"aPositionData", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aX", ",", "aY", ",", "aZ"}], "}"}], "/.", "\[VeryThinSpace]", 
     "data"}], "]"}]}], ";", 
  RowBox[{"sphereNormalData", "=", 
   RowBox[{"Normalize", "[", 
    RowBox[{"aPositionData", "-", "sphereCenterData"}], "]"}]}], ";", 
  RowBox[{"sphereNormalData", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sphereNormalData", ".", "propagationDirectionData"}], "<", 
      "0"}], ",", 
     RowBox[{"-", "sphereNormalData"}], ",", "sphereNormalData"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"bf1bea55-b008-46b9-97e1-10e6cc996c5c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"earthRadiusKm", "=", "6378.`"}], ";", 
  RowBox[{"solutionComparison", "=", 
   TagBox[GridBox[{
      {"\"\<model\>\"", "\"\<satellites\>\"", "\"\<\[Nu] = |v| (R_E/s)\>\"", \
"\"\<|v| (km/s)\>\"", "\"\<normal at A (GSE)\>\""},
      {"\"\<4-satellite plane\>\"", "\"\<A-D\>\"", "planeSpeedData", 
