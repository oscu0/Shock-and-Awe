Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[",
    RowBox[{"allFitInputSummary", ",", " ", "allFitResultSummary"}], "]"}],
   ";"}], "\n"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"allFitInputSummary", "[", "parameters_Association", "]"}], " ", ":=",
     " ",
    RowBox[{"Grid", "[", "\n", "  ",
     RowBox[{
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{
          RowBox[{"Style", "[",
           RowBox[{"\"\<Valid crossings\>\"", ",", " ", "Bold"}], "]"}], ",",
          " ",
          RowBox[{"StringRiffle", "[",
           RowBox[{
            RowBox[{"satelliteNames", "[",
             RowBox[{"parameters", "[", "\"\<availableSatellites\>\"", "]"}],
             "]"}], ",", " ", "\"\< -> \>\""}], "]"}]}], "}"}], ",", "\n",
        "   ",
        RowBox[{"{",
         RowBox[{
          RowBox[{"Style", "[",

           RowBox[{"\"\<Planar four-spacecraft subsets\>\"", ",", " ",
            "Bold"}], "]"}], ",", " ",
          RowBox[{"Length", "[",
           RowBox[{"parameters", "[", "\"\<planar\>\"", "]"}], "]"}]}], "}"}],
         ",", "\n", "   ",
        RowBox[{"{",
         RowBox[{
          RowBox[{"Style", "[",

           RowBox[{"\"\<Spherical five-spacecraft subsets\>\"", ",", " ",
            "Bold"}], "]"}], ",", " ",
          RowBox[{"Length", "[",
           RowBox[{"parameters", "[", "\"\<spherical\>\"", "]"}], "]"}]}],
         "}"}]}], "}"}], ",", "\n", "  ",
      RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ",
      RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}], ";"}], "\n"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"allFitResultSummary", "[", "allResults_Association", "]"}], " ", ":=",
    " ",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{", "rows", "}"}], ",", "\n", "  ",
     RowBox[{
      RowBox[{"rows", " ", "=", " ",
       RowBox[{"Flatten", "[", "\n", "    ",
        RowBox[{
         RowBox[{"Table", "[", "\n", "     ",
          RowBox[{
           RowBox[{"KeyValueMap", "[", "\n", "      ",
            RowBox[{
             RowBox[{"Function", "[",
              RowBox[{
               RowBox[{"{",
                RowBox[{"satelliteKey", ",", " ", "fit"}], "}"}], ",", "\n",
               "       ",
               RowBox[{"{",
                RowBox[{
                 RowBox[{"If", "[",
                  RowBox[{
                   RowBox[{"modelName", " ", "===", " ", "\"\<planar\>\""}], ",",
                    " ", "\"\<Plane\>\"", ",", " ", "\"\<Sphere\>\""}], "]"}],
                  ",", "\n", "        ",
                 RowBox[{"StringRiffle", "[",
                  RowBox[{
                   RowBox[{"satelliteNames", "[",
                    RowBox[{
                    RowBox[{"fit", "[", "\"\<parameters\>\"", "]"}],
                    "[", "\"\<satellites\>\"", "]"}], "]"}], ",",
                   " ", "\"\< -> \>\""}], "]"}], ",", "\n", "        ",
                 RowBox[{"NumberForm", "[",
                  RowBox[{
                   RowBox[{
                    RowBox[{"fit", "[", "\"\<result\>\"", "]"}],
                    "[", "\"\<speedKmPerSecond\>\"", "]"}], ",", " ",
                   RowBox[{"{",
                    RowBox[{"8", ",", " ", "1"}], "}"}]}], "]"}], ",", "\n",
                 "        ",
                 RowBox[{"NumberForm", "[",
                  RowBox[{
                   RowBox[{
                    RowBox[{"fit", "[", "\"\<result\>\"", "]"}],
                    "[", "\"\<normalGSE\>\"", "]"}], ",", " ",
                   RowBox[{"{",
                    RowBox[{"5", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}],
              "]"}], ",", "\n", "      ",
             RowBox[{"allResults", "[", "modelName", "]"}]}], "]"}], ",",
           "\n", "     ",
           RowBox[{"{",
            RowBox[{"modelName", ",", " ",
             RowBox[{"{",
              RowBox[{"\"\<planar\>\"", ",", " ", "\"\<spherical\>\""}],
              "}"}]}], "}"}]}], "]"}], ",", "\n", "    ", "1"}], "]"}]}], ";",
       "\n", "  ",
      RowBox[{"Grid", "[",
       RowBox[{
        RowBox[{"Prepend", "[",
         RowBox[{"rows", ",", "\n", "    ",
          RowBox[{"{",
           RowBox[{
            RowBox[{"Style", "[",
             RowBox[{"\"\<Model\>\"", ",", " ", "Bold"}], "]"}], ",", " ",
            RowBox[{"Style", "[",
             RowBox[{"\"\<Crossings\>\"", ",", " ", "Bold"}], "]"}], ",",
            "\n", "     ",
            RowBox[{"Style", "[",
