Cell[BoxData[
 RowBox[{"If", "[",
  RowBox[{
   RowBox[{"eventKeys", " ", "===", " ",
    RowBox[{"{", "}"}]}], ",", "\n", " ",
   RowBox[{"Style", "[",
    RowBox[{"\"\<No shock events were found in Shocks/Shock Params.json.\>\"",
      ",", " ",
     RowBox[{"Darker", "[", "Red", "]"}]}], "]"}], ",", "\n", " ",
   RowBox[{"DynamicModule", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"selectedEvent", " ", "=", " ",
        RowBox[{"First", "[", "eventKeys", "]"}]}], ",", " ",
       RowBox[{"selectedParameters", " ", "=", " ",
        RowBox[{"Missing", "[", "\"\<NotLoaded\>\"", "]"}]}], ",", "\n",
       "   ",
       RowBox[{"selectedResult", " ", "=", " ",
        RowBox[{"Missing", "[", "\"\<NotSolved\>\"", "]"}]}], ",", " ",
       RowBox[{"selectedWrite", " ", "=", " ",
        RowBox[{"Missing", "[", "\"\<NotWritten\>\"", "]"}]}]}], "}"}], ",",
     "\n", "  ",
     RowBox[{
      RowBox[{"selectedParameters", " ", "=", " ",
       RowBox[{"allFitParameters", "[", "selectedEvent", "]"}]}], ";", "\n",
      "  ",
      RowBox[{"Column", "[",
       RowBox[{
        RowBox[{"{", "\n", "    ",
         RowBox[{
          RowBox[{"Grid", "[",
           RowBox[{
            RowBox[{"{",
             RowBox[{"{",
              RowBox[{
               RowBox[{"Style", "[",
                RowBox[{"\"\<Event\>\"", ",", " ", "Bold"}], "]"}], ",", "\n",
                "       ",
               RowBox[{"PopupMenu", "[",
                RowBox[{
                 RowBox[{"Dynamic", "[",
                  RowBox[{"selectedEvent", ",", "\n", "         ",
                   RowBox[{
                    RowBox[{"(",
                    RowBox[{
                    RowBox[{"selectedEvent", " ", "=", " ", "#"}], ";", " ",
                    RowBox[{"selectedParameters", " ", "=", " ",
                    RowBox[{"allFitParameters", "[", "#", "]"}]}], ";", "\n",
                    "           ",
                    RowBox[{"selectedResult", " ", "=", " ",
                    RowBox[{"Missing", "[", "\"\<NotSolved\>\"", "]"}]}], ";",
                     " ",
                    RowBox[{"selectedWrite", " ", "=", " ",
                    RowBox[{"Missing", "[", "\"\<NotWritten\>\"", "]"}]}]}],
                    ")"}], " ", "&"}]}], "]"}], ",", " ", "eventKeys"}],
                "]"}]}], "}"}], "}"}], ",", "\n", "     ",
            RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ",", "\n",
           "    ",
          RowBox[{"Dynamic", "[",
           RowBox[{"If", "[",
            RowBox[{
             RowBox[{"AssociationQ", "[", "selectedParameters", "]"}], ",",
             " ",
             RowBox[{"allFitInputSummary", "[", "selectedParameters", "]"}], ",",
              "\n", "      ",
             RowBox[{"Style", "[",

              RowBox[{"\"\<This event has no valid GSE crossing records.\>\"",
                ",", " ",
               RowBox[{"Darker", "[", "Red", "]"}]}], "]"}]}], "]"}], "]"}], ",",
           "\n", "    ",
          RowBox[{"Button", "[",

           RowBox[{"\"\<Solve and write all available physical fits\>\"", ",",
             "\n", "     ",
            RowBox[{
             RowBox[{"selectedResult", " ", "=", " ",
              RowBox[{
              "solveAllShockNormals", "[", "selectedParameters", "]"}]}], ";",
              "\n", "     ",
             RowBox[{"selectedWrite", " ", "=", " ",
              RowBox[{"writeAllShockSurfaceResults", "[",
               RowBox[{"selectedEvent", ",", " ", "selectedResult"}],
               "]"}]}]}], ",", "\n", "     ",
            RowBox[{"Enabled", " ", "->", " ",
             RowBox[{"Dynamic", "[",
              RowBox[{"AssociationQ", "[", "selectedParameters", "]"}],
              "]"}]}], ",", " ",
            RowBox[{"Method", " ", "->", " ", "\"\<Queued\>\""}]}], "]"}], ",",
           "\n", "    ",
          RowBox[{"Dynamic", "[",
           RowBox[{"Which", "[", "\n", "      ",
            RowBox[{
             RowBox[{"AssociationQ", "[", "selectedResult", "]"}], ",", " ",
             RowBox[{"allFitResultSummary", "[", "selectedResult", "]"}], ",",
              "\n", "      ",
             RowBox[{"selectedResult", " ", "===", " ",
              RowBox[{"Missing", "[", "\"\<NotSolved\>\"", "]"}]}], ",", "\n",
              "       ",
             RowBox[{"Style", "[",

              RowBox[{"\"\<Use the button to calculate every available fit.\>\
\"", ",", " ", "Gray"}], "]"}], ",", "\n", "      ", "True", ",", " ",
             RowBox[{"Style", "[",

              RowBox[{"\"\<The solve failed; see the messages above.\>\"", ",",
                " ",
               RowBox[{"Darker", "[", "Red", "]"}]}], "]"}]}], "]"}], "]"}], ",",
           "\n", "    ",
          RowBox[{"Dynamic", "[",
           RowBox[{"Which", "[", "\n", "      ",
            RowBox[{
             RowBox[{"AssociationQ", "[", "selectedWrite", "]"}], ",", "\n",
             "       ",
             RowBox[{"Style", "[",

              RowBox[{"\"\<Replaced this event's stored fit groups with every \
accepted physical fit.\>\"", ",", " ",
               RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", "\n",
             "      ",
             RowBox[{"selectedWrite", " ", "===", " ",
              RowBox[{"Missing", "[", "\"\<NotWritten\>\"", "]"}]}], ",", " ",
              "Nothing", ",", "\n", "      ", "True", ",", " ",
             RowBox[{"Style", "[",
              RowBox[{"\"\<Results were not written.\>\"", ",", " ",
               RowBox[{"Darker", "[", "Red", "]"}]}], "]"}]}], "]"}], "]"}]}],
          "\n", "    ", "}"}], ",", " ",
        RowBox[{"Spacings", " ", "->", " ", "1.5"}]}], "]"}]}]}], "\n", "  ",
    "]"}]}], "\n", " ", "]"}]], "Input",
 CellLabel->
  "In[336]:=",ExpressionUUID->"2c2a33c9-fd0c-4ef9-9ce1-c39e3f8e780f"],

