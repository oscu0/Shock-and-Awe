Cell[CellGroupData[{

Cell["Spacecraft Sets", "Section",ExpressionUUID->"caf730bc-1957-40e9-84f7-fecd786dc231"],

Cell["\<\
Configure the plane and sphere crossing sets independently. Use \"mms\" in \
either set to select the first available MMS probe (MMS1 through MMS4) for \
that event. Each set is sorted by crossing time before solving.\
\>", "Text",ExpressionUUID->"82bf79d9-c1d1-4461-bd28-aa470c183292"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eventKeys", " ", "=", " ",
   RowBox[{"Sort", "@",
    RowBox[{"Select", "[",
     RowBox[{
      RowBox[{"Keys", "[", "shockParams", "]"}], ",", " ", "StringQ"}],
     "]"}]}]}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"planeSatellites", " ", "=", " ",
    RowBox[{"{",
     RowBox[{"\"\<mms\>\"", ",", " ", "\"\<wind\>\"", ",",
      " ", "\"\<dscovr\>\"", ",", " ", "\"\<themis_b\>\""}], "}"}]}], ";"}],
  "\n",
  RowBox[{"(*",
   RowBox[{
    RowBox[{"planeSatellites", " ", "=", " ",
     RowBox[{"{",
      RowBox[{"\"\<ace\>\"", ",", " ", "\"\<wind\>\"", ",",
       " ", "\"\<dscovr\>\"", ",", " ", "\"\<themis_b\>\""}], "}"}]}], ";"}],
   "*)"}]}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"sphericalSatellites", " ", "=", " ",
   RowBox[{"{",
    RowBox[{"\"\<ace\>\"", ",", " ", "\"\<wind\>\"", ",",
     " ", "\"\<dscovr\>\"", ",", " ", "\"\<themis_b\>\"", ",",
     " ", "\"\<mms\>\""}], "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"mmsSatellites", " ", "=", " ",
   RowBox[{"{",
    RowBox[{"\"\<mms1\>\"", ",", " ", "\"\<mms2\>\"", ",", " ", "\"\<mms3\>\"",
      ",", " ", "\"\<mms4\>\""}], "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{
  "propagationDirectionSource", " ", "=", " ", "\"\<UpstreamVelocity\>\""}],
  ";"}], "\n",
 RowBox[{
  RowBox[{"satelliteLabels", " ", "=", " ",
   RowBox[{"<|",
    RowBox[{
     RowBox[{"\"\<ace\>\"", " ", "->", " ", "\"\<ACE\>\""}], ",", " ",
     RowBox[{"\"\<wind\>\"", " ", "->", " ", "\"\<Wind\>\""}], ",", " ",
     RowBox[{"\"\<dscovr\>\"", " ", "->", " ", "\"\<DSCOVR\>\""}], ",", "\n",
     " ",
     RowBox[{"\"\<themis_b\>\"", " ", "->", " ", "\"\<THEMIS-B\>\""}], ",",
     " ",
     RowBox[{"\"\<mms1\>\"", " ", "->", " ", "\"\<MMS1\>\""}], ",", " ",
     RowBox[{"\"\<mms2\>\"", " ", "->", " ", "\"\<MMS2\>\""}], ",", " ",
     RowBox[{"\"\<mms3\>\"", " ", "->", " ", "\"\<MMS3\>\""}], ",", " ",
     RowBox[{"\"\<mms4\>\"", " ", "->", " ", "\"\<MMS4\>\""}]}], "|>"}]}],
  ";"}], "\n",
 RowBox[{
  RowBox[{"ClearAll", "[", "satelliteNames", "]"}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"satelliteNames", "[", "satellites_List", "]"}], " ", ":=", " ",
   RowBox[{
    RowBox[{"(",
     RowBox[{
      RowBox[{"Lookup", "[",
       RowBox[{"satelliteLabels", ",", " ", "#", ",", " ", "#"}], "]"}], " ",
      "&"}], ")"}], " ", "/@", " ", "satellites"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.993805718020355*^9, 3.993805768729566*^9}, {
  3.993806512970055*^9, 3.993806513169402*^9}, {3.993807199253377*^9,
