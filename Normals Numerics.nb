      "]"}], ",", "\"\<SunRadial\>\"", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1.`"}], ",", "0.`", ",", "0.`"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"7ecc26f1-9863-49bf-aaf2-1f0e00c4917c"]
}, Open  ]],

