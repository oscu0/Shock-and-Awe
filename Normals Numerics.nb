Cell[CellGroupData[{

Cell["Results", "Section", ExpressionUUID -> "dca39f9e-4baa-44fd-a01c-2b311c13e7a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "eventSummary", "]"}], ";", 
  RowBox[{
   RowBox[{"eventSummary", "[", "eventKey_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "specification", ",", "data", ",", "result", ",", "selectedSatellites", 
       ",", "summary"}], "}"}], ",", 
     RowBox[{
      RowBox[{"specification", "=", 
       RowBox[{"eventSpecifications", "[", "eventKey", "]"}]}], ";", 
      RowBox[{"data", "=", 
       RowBox[{"eventSolverData", "[", "eventKey", "]"}]}], ";", 
      RowBox[{"result", "=", 
       RowBox[{"eventResults", "[", "eventKey", "]"}]}], ";", 
      RowBox[{"selectedSatellites", "=", 
       RowBox[{"specification", "[", "\"\<satellites\>\"", "]"}]}], ";", 
      RowBox[{"summary", "=", 
       TagBox[GridBox[{
          {
           StyleBox["\"\<Event\>\"",
            StripOnInput->False,
            FontWeight->Bold], "eventKey", "\[SpanFromLeft]", 
           "\[SpanFromLeft]", "\[SpanFromLeft]"},
          {
           StyleBox["\"\<Satellites (crossing order)\>\"",
            StripOnInput->False,
            FontWeight->Bold], 
           RowBox[{"StringRiffle", "[", 
            RowBox[{"selectedSatellites", ",", "\"\< -> \>\""}], "]"}], 
           "\[SpanFromLeft]", "\[SpanFromLeft]", "\[SpanFromLeft]"},
          {
           StyleBox["\"\<Propagation direction (GSE)\>\"",
            StripOnInput->False,
            FontWeight->Bold], 
           TagBox[
            RowBox[{"Lookup", "[", 
             RowBox[{"data", ",", 
              RowBox[{"{", 
               RowBox[{"vXN", ",", "vYN", ",", "vZN"}], "}"}]}], "]"}],
            NumberForm[#, {Infinity, 4}]& ], "\[SpanFromLeft]", 
           "\[SpanFromLeft]", "\[SpanFromLeft]"},
          {
           StyleBox["\"\<Model\>\"",
            StripOnInput->False,
            FontWeight->Bold], 
           StyleBox["\"\<Crossings\>\"",
            StripOnInput->False,
            FontWeight->Bold], 
           StyleBox["\"\<Speed (R_E/s)\>\"",
            StripOnInput->False,
            FontWeight->Bold], 
           StyleBox["\"\<Speed (km/s)\>\"",
            StripOnInput->False,
            FontWeight->Bold], 
           StyleBox["\"\<Normal (GSE)\>\"",
            StripOnInput->False,
            FontWeight->Bold]},
          {"\"\<4-satellite plane\>\"", 
           RowBox[{"StringRiffle", "[", 
            RowBox[{
             RowBox[{"Take", "[", 
              RowBox[{"selectedSatellites", ",", "4"}], "]"}], 
             ",", "\"\< -> \>\""}], "]"}], 
           TagBox[
            RowBox[{
             RowBox[{"result", "[", "\"\<planar\>\"", "]"}], 
             "[", "\"\<speedREPerSecond\>\"", "]"}],
            NumberForm[#, {Infinity, 6}]& ], 
           TagBox[
            RowBox[{
             RowBox[{"result", "[", "\"\<planar\>\"", "]"}], 
             "[", "\"\<speedKmPerSecond\>\"", "]"}],
            NumberForm[#, {Infinity, 2}]& ], 
           TagBox[
            RowBox[{
             RowBox[{"result", "[", "\"\<planar\>\"", "]"}], 
             "[", "\"\<normalGSE\>\"", "]"}],
            NumberForm[#, {Infinity, 4}]& ]},
          {"\"\<5-satellite sphere\>\"", 
           RowBox[{"StringRiffle", "[", 
            RowBox[{"selectedSatellites", ",", "\"\< -> \>\""}], "]"}], 
           TagBox[
            RowBox[{
             RowBox[{"result", "[", "\"\<spherical\>\"", "]"}], 
             "[", "\"\<speedREPerSecond\>\"", "]"}],
            NumberForm[#, {Infinity, 6}]& ], 
           TagBox[
            RowBox[{
             RowBox[{"result", "[", "\"\<spherical\>\"", "]"}], 
             "[", "\"\<speedKmPerSecond\>\"", "]"}],
            NumberForm[#, {Infinity, 2}]& ], 
           TagBox[
            RowBox[{
             RowBox[{"result", "[", "\"\<spherical\>\"", "]"}], 
             "[", "\"\<normalGSE\>\"", "]"}],
            NumberForm[#, {Infinity, 4}]& ]}
         },
         AutoDelete->False,
         GridBoxAlignment->{"Columns" -> {{Left}}},
         GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
         GridBoxItemSize->{
          "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
         GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}],
        "Grid"]}], ";", 
      TagBox[GridBox[{
         {"summary"},
         {
          RowBox[{"Dataset", "[", 
           RowBox[{"Association", "[", 
            RowBox[{
             RowBox[{"\"\<4-satellite plane\>\"", "\[Rule]", 
              RowBox[{"result", "[", "\"\<planar\>\"", "]"}]}], ",", 
             RowBox[{"\"\<5-satellite sphere\>\"", "\[Rule]", 
              RowBox[{"result", "[", "\"\<spherical\>\"", "]"}]}]}], "]"}], 
           "]"}]}
        },
        DefaultBaseStyle->"Column",
        GridBoxAlignment->{"Columns" -> {{Left}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
        GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{1.5}}}],
       "Column"]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"1ecdf6b8-a1c7-4777-828d-582aeedab660"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
