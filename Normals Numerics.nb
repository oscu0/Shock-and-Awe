 CellLabel->"In[26]:=",ExpressionUUID->"6f0720ac-7031-4dce-bdd1-a3106281d380"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "toSolverData", "]"}], ";", 
  RowBox[{
   StyleBox[
    RowBox[{"toSolverData", "::", "event"}], "MessageName"], 
   "=", "\"\<Event `1` is not present in the shock catalogue.\>\""}], ";", 
  RowBox[{
   StyleBox[
    RowBox[{"toSolverData", "::", "selection"}], "MessageName"], 
   "=", "\"\<Select exactly five distinct satellites in crossing \
order.\>\""}], ";", 
  RowBox[{
   StyleBox[
    RowBox[{"toSolverData", "::", "satellite"}], "MessageName"], 
   "=", "\"\<Event `1` has no record for: `2`.\>\""}], ";", 
  RowBox[{
   StyleBox[
    RowBox[{"toSolverData", "::", "position"}], "MessageName"], 
   "=", "\"\<Every selected satellite must have a numeric three-component \
position.\>\""}], ";", 
  RowBox[{
   StyleBox[
    RowBox[{"toSolverData", "::", "frame"}], "MessageName"], 
   "=", "\"\<Every selected position must use Cartesian GSE coordinates in \
R_E.\>\""}], ";", 
  RowBox[{
   StyleBox[
    RowBox[{"toSolverData", "::", "order"}], "MessageName"], 
   "=", "\"\<The selected satellites' crossing times must be strictly \
increasing.\>\""}], ";", 
  RowBox[{
   StyleBox[
    RowBox[{"toSolverData", "::", "velocity"}], "MessageName"], 
   "=", "\"\<The propagation vector must be a nonzero numeric three-vector.\>\
\""}], ";", 
  RowBox[{
   RowBox[{"toSolverData", "[", 
    RowBox[{
    "eventKey_String", ",", "satellites_List", ",", "velocityGSE_List"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "event", ",", "missingSatellites", ",", "entries", ",", 
       "positionRecords", ",", "positions", ",", "crossingTimes", ",", 
       "relativeTimes", ",", "direction"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"shockParams", ",", "eventKey"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           StyleBox[
            RowBox[{"toSolverData", "::", "event"}], "MessageName"], ",", 
           "eventKey"}], "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "satellites", "]"}], "\[NotEqual]", "5"}], "||", 
         RowBox[{"!", 
          RowBox[{"DuplicateFreeQ", "[", "satellites", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          StyleBox[
           RowBox[{"toSolverData", "::", "selection"}], "MessageName"], "]"}],
          ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      RowBox[{"event", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"shockParams", ",", "eventKey"}], "]"}]}], ";", 
      RowBox[{"missingSatellites", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"satellites", ",", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"event", ",", "#1"}], "]"}]}], "&"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"missingSatellites", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           StyleBox[
            RowBox[{"toSolverData", "::", "satellite"}], "MessageName"], ",", 
           "eventKey", ",", "missingSatellites"}], "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      RowBox[{"entries", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"event", ",", "satellites"}], "]"}]}], ";", 
      RowBox[{"positionRecords", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Lookup", "[", 
           RowBox[{"#1", ",", "\"\<position\>\"", ",", 
            RowBox[{"Missing", "[", "\"\<Position\>\"", "]"}]}], "]"}], "&"}],
          ")"}], "/@", "entries"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"positionRecords", ",", "AssociationQ"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          StyleBox[
           RowBox[{"toSolverData", "::", "position"}], "MessageName"], "]"}], 
         ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"positionRecords", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"#1", ",", "\"\<frame\>\"", ",", 
                RowBox[{"Missing", "[", "\"\<Frame\>\"", "]"}]}], "]"}], 
              "===", "\"\<GSE\>\""}], "&&", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"#1", ",", "\"\<units\>\"", ",", 
                RowBox[{"Missing", "[", "\"\<Units\>\"", "]"}]}], "]"}], 
              "===", "\"\<R_E\>\""}]}], "&"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          StyleBox[
           RowBox[{"toSolverData", "::", "frame"}], "MessageName"], "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      RowBox[{"positions", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"#1", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], 
              "}"}]}], "]"}], "&"}], ")"}], "/@", "positionRecords"}], 
        "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Dimensions", "[", "positions", "]"}], "=!=", 
          RowBox[{"{", 
           RowBox[{"5", ",", "3"}], "}"}]}], "||", 
         RowBox[{"!", 
          RowBox[{"MatrixQ", "[", 
           RowBox[{"positions", ",", "NumericQ"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          StyleBox[
           RowBox[{"toSolverData", "::", "position"}], "MessageName"], "]"}], 
         ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      RowBox[{"crossingTimes", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"AbsoluteTime", "[", 
           RowBox[{"DateObject", "[", 
            RowBox[{
             RowBox[{"Lookup", "[", 
              RowBox[{"#1", ",", "\"\<t0\>\""}], "]"}], ",", 
             RowBox[{"TimeZone", "\[Rule]", "0"}]}], "]"}], "]"}], "&"}], 
         ")"}], "/@", "entries"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Differences", "[", "crossingTimes", "]"}], ",", 
           RowBox[{
            RowBox[{"#1", ">", "0"}], "&"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          StyleBox[
           RowBox[{"toSolverData", "::", "order"}], "MessageName"], "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      RowBox[{"relativeTimes", "=", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Rest", "[", "crossingTimes", "]"}], "-", 
           RowBox[{"First", "[", "crossingTimes", "]"}]}], "]"}], ",", 
         FractionBox["1", 
          SuperscriptBox["10", "6"]]}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"VectorQ", "[", 
           RowBox[{"velocityGSE", ",", "NumericQ"}], "]"}]}], "||", 
         RowBox[{
          TemplateBox[{
            RowBox[{"N", "[", "velocityGSE", "]"}]},
           "Norm"], "\[Equal]", "0"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          StyleBox[
           RowBox[{"toSolverData", "::", "velocity"}], "MessageName"], "]"}], 
         ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      RowBox[{"direction", "=", 
       RowBox[{"Normalize", "[", 
        RowBox[{"N", "[", "velocityGSE", "]"}], "]"}]}], ";", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", "coordinateSymbols", "]"}], ",", 
          RowBox[{"Flatten", "[", "positions", "]"}]}], "]"}], ",", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{"relativeTimeSymbols", ",", "relativeTimes"}], "]"}], ",", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vXN", ",", "vYN", ",", "vZN"}], "}"}], ",", "direction"}],
          "]"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"c49eefa1-4f12-4cf4-916b-be481eea443f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "propagationDirectionVector", "]"}], ";", 
  RowBox[{
   RowBox[{"propagationDirectionVector", "[", 
    RowBox[{"eventKey_String", ",", "velocitySatellite_String"}], "]"}], ":=", 
