Cell[CellGroupData[{
Cell["Normals Numerics", "Title",ExpressionUUID->"d3410f31-fb32-47d9-8088-84bd6d88920a"],

Cell["\<\
Choose a shock from the catalogue, inspect the fixed chronological spacecraft \
inputs, then explicitly solve and write both fits. Selecting an event does \
not run either solver.\
\>", "Text",ExpressionUUID->"9acd418c-7924-410e-82a6-312d81011e3a"],

Cell[CellGroupData[{

Cell["Load Solver", "Section",ExpressionUUID->"38c62929-d52e-430c-b386-669222d96526"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "loadNormalsSolver", "]"}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"loadNormalsSolver", "[", "]"}], " ", ":=", " ",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
      "solverPath", ",", " ", "heldNotebook", ",", " ",
       "initializationBoxes"}], "}"}], ",", "\n", " ",
     RowBox[{
      RowBox[{"solverPath", " ", "=", " ",
       RowBox[{"FileNameJoin", "[",
        RowBox[{"{",
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",",
          " ", "\"\<Normals Solver.nb\>\""}], "}"}], "]"}]}], ";", "\n", " ",

      RowBox[{"heldNotebook", " ", "=", " ",
       RowBox[{"ToExpression", "[",
        RowBox[{
         RowBox[{"Import", "[",
          RowBox[{"solverPath", ",", " ", "\"\<Text\>\""}], "]"}], ",", " ",
         "InputForm", ",", " ", "HoldComplete"}], "]"}]}], ";", "\n", " ",
      RowBox[{"initializationBoxes", " ", "=", " ",
       RowBox[{"Cases", "[",
        RowBox[{"heldNotebook", ",", "\n", "   ",
         RowBox[{
          RowBox[{"HoldPattern", "[",
           RowBox[{
            RowBox[{"Cell", "[",
             RowBox[{
              RowBox[{"BoxData", "[", "boxes_", "]"}], ",",
              " ", "\"\<Input\>\"", ",", " ", "options___"}], "]"}], " ", "/;",
             "\n", "      ",
            RowBox[{"MemberQ", "[",
             RowBox[{
              RowBox[{"{", "options", "}"}], ",", " ",
              RowBox[{"InitializationCell", " ", "->", " ", "True"}]}],
             "]"}]}], "]"}], " ", ":>", " ", "boxes"}], ",", " ",
         "Infinity"}], "]"}]}], ";", "\n", " ",
      RowBox[{"Scan", "[",
       RowBox[{
        RowBox[{
         RowBox[{"ToExpression", "[",
          RowBox[{"#", ",", " ", "StandardForm"}], "]"}], " ", "&"}], ",",
        " ", "initializationBoxes"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"loadNormalsSolver", "[", "]"}], ";"}]}], "Input",
 CellLabel->
  "In[431]:=",ExpressionUUID->"32276451-25eb-46dd-8e78-81335f2c842e"]
}, Open  ]],

