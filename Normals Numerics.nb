Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "loadNormalsSolver", "]"}], ";", 
  RowBox[{
   RowBox[{"loadNormalsSolver", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"solverPath", ",", "heldNotebook", ",", "initializationBoxes"}],
       "}"}], ",", 
     RowBox[{
      RowBox[{"solverPath", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], 
          ",", "\"\<Normals Solver.nb\>\""}], "}"}], "]"}]}], ";", 
      RowBox[{"heldNotebook", "=", 
       RowBox[{"ToExpression", "[", 
        RowBox[{
         RowBox[{"Import", "[", 
          RowBox[{"solverPath", ",", "\"\<Text\>\""}], "]"}], ",", 
         "InputForm", ",", "HoldComplete"}], "]"}]}], ";", 
      RowBox[{"initializationBoxes", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{"heldNotebook", ",", 
         RowBox[{
          RowBox[{"HoldPattern", "[", 
           RowBox[{"Cell", "[", 
            RowBox[{
             RowBox[{"BoxData", "[", "boxes_", "]"}], ",", "\"\<Input\>\"", ",",
              "___", ",", 
             RowBox[{"InitializationCell", "\[Rule]", "True"}], ",", "___"}], 
            "]"}], "]"}], "\[RuleDelayed]", "boxes"}], ",", "\[Infinity]"}], 
        "]"}]}], ";", 
      RowBox[{"Scan", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ToExpression", "[", 
          RowBox[{"#1", ",", "StandardForm"}], "]"}], "&"}], ",", 
        "initializationBoxes"}], "]"}], ";"}]}], "]"}]}], ";", 
  RowBox[{"loadNormalsSolver", "[", "]"}], ";"}]], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"e035b3ba-8f8e-496a-a7b8-9a33181611aa"]
