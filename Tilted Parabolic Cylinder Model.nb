Cell["\<\
Crossing A anchors the surface and reduces to 0 == 0, so Rest removes it. The \
five supplied crossings therefore give four nontrivial equations for {nu, \
alpha, beta, lambda, psi}. A sixth crossing supplies the fifth equation \
needed for a just-determined cylindrical fit.\
\>", "Text",ExpressionUUID->"3125ced5-95e0-4ffd-9c24-7686b9ecaf56"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sixthObservation", " ", "=", " ",
    RowBox[{"{",
     RowBox[{"tAF", ",", " ",
      RowBox[{"{",
       RowBox[{"fX", ",", " ", "fY", ",", " ", "fZ"}], "}"}]}], "}"}]}],
   ";"}], "\n"}], "\n",
 RowBox[{
  RowBox[{"observations6", " ", "=", " ",
   RowBox[{"Append", "[",
    RowBox[{"observations", ",", " ", "sixthObservation"}], "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"eqs6", " ", "=", " ",
    RowBox[{"Thread", "[",
     RowBox[{
      RowBox[{"(",
       RowBox[{"frontResidual", " ", "/@", " ",
        RowBox[{"Rest", "[", "observations6", "]"}]}], ")"}], " ", "==", " ",
      "0"}], "]"}]}], ";"}], "\n", "\n",
  RowBox[{"(*", " ",
   RowBox[{
    RowBox[{
    "After", " ", "assigning", " ", "numerical", " ", "values", " ", "to", " ",
      "tAF"}], ",", " ", "fX", ",", " ", "fY", ",", " ",
    RowBox[{"and", " ",
     RowBox[{"fZ", ":"}]}]}], " ", "*)"}], "\n"}], "\n",
 RowBox[{
  RowBox[{"(*", "\n",
   RowBox[{
    RowBox[{"fit", " ", "=", " ",
     RowBox[{"FindRoot", "[", "\n", "  ",
      RowBox[{"eqs6", ",", "\n", "  ",
       RowBox[{"{", "\n", "    ",
        RowBox[{
         RowBox[{"{",
          RowBox[{"nu", ",", " ", "0.094"}], "}"}], ",", "\n", "    ",
         RowBox[{"{",
          RowBox[{"alpha", ",", " ", "0."}], "}"}], ",", "\n", "    ",
         RowBox[{"{",
          RowBox[{"beta", ",", " ", "0."}], "}"}], ",", "\n", "    ",
         RowBox[{"{",
          RowBox[{"lambda", ",", " ", "0.005"}], "}"}], ",", "\n", "    ",
         RowBox[{"{",
          RowBox[{"psi", ",", " ", "0."}], "}"}]}], "\n", "  ", "}"}]}], "\n",
       "]"}]}], ";"}], "\n", "*)"}]}]}], "Input",
 CellLabel->
  "In[140]:=",ExpressionUUID->"2ad620ad-4cdd-4dcf-bb8f-1f5b14deaf68"],

Cell["\<\
With exactly six crossings the model has no redundant residual. Seven or more \
crossings permit a least-squares fit and a geometric consistency test.\
\>", "Text",ExpressionUUID->"cda2fb27-2d1b-4d4e-bc76-0905889aa5df"]
}, Open  ]]
}, Open  ]]
