Cell["\<\
Construct the reference point, projector, transverse basis, and observed \
spacetime points.\
\>", "Text",ExpressionUUID->"da7d8ab9-8e00-4441-a7aa-b7c4281da141"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pAData", " ", "=", " ",
   RowBox[{
    RowBox[{"{",
     RowBox[{"aX", ",", " ", "aY", ",", " ", "aZ"}], "}"}], " ", "/.", " ",
    "data"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"dHatData", " ", "=", " ",
    RowBox[{"Normalize", "[",
     RowBox[{
      RowBox[{"{",
       RowBox[{"vXN", ",", " ", "vYN", ",", " ", "vZN"}], "}"}], " ", "/.",
      " ", "data"}], "]"}]}], ";"}], "\n"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"{",
    RowBox[{"e1Data", ",", " ", "e2Data"}], "}"}], " ", "=", " ",
   RowBox[{"makeTransverseBasis", "[", "dHatData", "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"pPerpData", " ", "=", " ",
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "3", "]"}], " ", "-", " ",
     RowBox[{"Outer", "[",
      RowBox[{"Times", ",", " ", "dHatData", ",", " ", "dHatData"}],
      "]"}]}]}], ";"}], "\n"}], "\n",
 RowBox[{
  RowBox[{"observations", " ", "=", " ",
   RowBox[{
    RowBox[{"{", "\n", "    ",
     RowBox[{
      RowBox[{"{",
       RowBox[{"0.", ",", " ",
        RowBox[{"{",
         RowBox[{"aX", ",", " ", "aY", ",", " ", "aZ"}], "}"}]}], "}"}], ",",
      "\n", "    ",
      RowBox[{"{",
       RowBox[{"tAB", ",", " ",
        RowBox[{"{",
         RowBox[{"bX", ",", " ", "bY", ",", " ", "bZ"}], "}"}]}], "}"}], ",",
      "\n", "    ",
      RowBox[{"{",
       RowBox[{"tAC", ",", " ",
        RowBox[{"{",
         RowBox[{"cX", ",", " ", "cY", ",", " ", "cZ"}], "}"}]}], "}"}], ",",
      "\n", "    ",
      RowBox[{"{",
       RowBox[{"tAD", ",", " ",
        RowBox[{"{",
         RowBox[{"dX", ",", " ", "dY", ",", " ", "dZ"}], "}"}]}], "}"}], ",",
      "\n", "    ",
      RowBox[{"{",
       RowBox[{"tAE", ",", " ",
        RowBox[{"{",
         RowBox[{"eX", ",", " ", "eY", ",", " ", "eZ"}], "}"}]}], "}"}]}],
     "\n", "    ", "}"}], " ", "/.", " ", "data"}]}], ";"}]}], "Input",
 CellLabel->
  "In[129]:=",ExpressionUUID->"f77e654a-ceaf-49e3-9cd1-c45aad7824c2"],

Cell["\<\
For each observed spacetime point, project its displacement into the \
transverse plane and evaluate the scalar surface residual.\
\>", "Text",ExpressionUUID->"75fbbe29-8303-4da7-8cf3-932da8e6de5e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["q", "i"], "=", "pPerpData", ".",
   RowBox[{"(",
    RowBox[{
     SubscriptBox["p", "i"], "-", "pAData"}], ")"}]}],
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"5ffd6b75-ee59-4831-\
bb3b-4727acc3347f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"gData", " ", "=", " ",
   RowBox[{
    RowBox[{"alpha", " ", "e1Data"}], " ", "+", " ",
    RowBox[{"beta", " ", "e2Data"}]}]}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"cHatData", " ", "=", " ",
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", "psi", "]"}], " ", "e1Data"}], " ", "+", " ",
     RowBox[{
      RowBox[{"Sin", "[", "psi", "]"}], " ", "e2Data"}]}]}], ";"}], "\n"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"frontResidual", "[",
     RowBox[{"{",
      RowBox[{"time_", ",", " ", "position_"}], "}"}], "]"}], " ", ":=", " ",

    RowBox[{"Module", "[",
     RowBox[{
      RowBox[{"{",
       RowBox[{"dp", ",", " ", "q"}], "}"}], ",", "\n", "  ",
      RowBox[{
       RowBox[{"dp", " ", "=", " ",
        RowBox[{"position", " ", "-", " ", "pAData"}]}], ";", "\n", "  ",
       RowBox[{"q", " ", "=", " ",
        RowBox[{"pPerpData", " ", ".", " ", "dp"}]}], ";", "\n", "\n", "  ",
       RowBox[{
        RowBox[{"dHatData", " ", ".", " ", "dp"}], "\n", "   ", "-", " ",
        RowBox[{"nu", " ", "time"}], "\n", "   ", "-", " ",
        RowBox[{"gData", " ", ".", " ", "q"}], "\n", "   ", "-", " ",
        RowBox[{
         RowBox[{"lambda", "/", "2"}], " ",
         RowBox[{
          RowBox[{"(",
           RowBox[{"cHatData", " ", ".", " ", "q"}], ")"}], "^",
          "2"}]}]}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n",
 RowBox[{
  RowBox[{"residuals", " ", "=", " ",
   RowBox[{"frontResidual", " ", "/@", " ",
    RowBox[{"Rest", "[", "observations", "]"}]}]}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"eqs", " ", "=", " ",
    RowBox[{"Thread", "[",
     RowBox[{"residuals", " ", "==", " ", "0"}], "]"}]}], ";"}], "\n"}], "\n",
 RowBox[{"eqs", " ", "//", " ", "Column"}]}], "Input",
 CellLabel->
  "In[134]:=",ExpressionUUID->"eafd40ce-9083-412d-b0ef-89dc19b6c431"],

