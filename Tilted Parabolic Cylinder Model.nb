Notebook[{

Cell[CellGroupData[{
Cell["Tilted Parabolic-Cylinder Shock Front", "Title",ExpressionUUID->"d4ad322c-1703-4821-b544-bfc9791f5648"],

Cell["\<\
A freely tilted local shock patch translating along the known ambient \
solar-wind direction. The propagation direction fixes the motion, not the \
local surface normal.\
\>", "Text",ExpressionUUID->"88718d99-8b3c-4ffa-8ad7-a44c35fc641a"],

Cell[BoxData[
 FormBox[
  FrameBox[
   RowBox[{
    RowBox[{StyleBox["r", FontWeight->Bold], "(",
     RowBox[{StyleBox["q", FontWeight->Bold], ",", "t"}], ")"}], "=",
    RowBox[{
     SubscriptBox[StyleBox["p", FontWeight->Bold], "A"], "+",
     StyleBox["q", FontWeight->Bold], "+",
     RowBox[{"[",
      RowBox[{
       RowBox[{"\[Nu]", RowBox[{"(",
          RowBox[{"t", "-", SubscriptBox["t", "A"]}], ")"}]}], "+",
       RowBox[{StyleBox["g", FontWeight->Bold], "\[CenterDot]",
        StyleBox["q", FontWeight->Bold]}], "+",
       RowBox[{
        FractionBox["\[Lambda]", "2"],
        SuperscriptBox[
         RowBox[{"(",
          RowBox[{
           OverscriptBox[StyleBox["c", FontWeight->Bold], "^"],
           "\[CenterDot]", StyleBox["q", FontWeight->Bold]}], ")"}],
         "2"]}]}], "]"}], "\[ThinSpace]",
     OverscriptBox[StyleBox["d", FontWeight->Bold], "^"]}]}],
   Background->RGBColor[0.97, 0.98, 1.],
   FrameMargins->{{14, 14}, {10, 10}},
   FrameStyle->GrayLevel[0.72],
   RoundingRadius->5],
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"1f92e70a-a135-4002-\
be73-e2d3a43269eb"],

Cell["\<\
The transverse parameter vector q satisfies q.dHat = 0. Equivalently, q = u \
e1Hat + v e2Hat. Thus u and v are merely coordinates in the plane \
perpendicular to the ambient solar-wind direction.\
\>", "Text",ExpressionUUID->"1fd1d0ef-786b-4d18-af47-bf7345a94755"],

Cell[CellGroupData[{

Cell["Geometry definitions", "Section",ExpressionUUID->"4ce762e3-66e4-4b04-98c6-98c0875c171c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeTransverseBasis", "[", "d_", "]"}], " ", ":=", " ",
    RowBox[{"Module", "[",
     RowBox[{
      RowBox[{"{",
       RowBox[{"seed", ",", " ", "e1", ",", " ", "e2"}], "}"}], ",", "\n",
      "  ",
      RowBox[{
       RowBox[{"seed", " ", "=", " ",
        RowBox[{"If", "[",
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[",
            RowBox[{"d", " ", ".", " ",
             RowBox[{"{",
              RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}],
           " ", "<", " ", "0.9"}], ",", " ",
          RowBox[{"{",
           RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ",
          RowBox[{"{",
           RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}]}], "]"}]}], ";",
        "\n", "  ",
       RowBox[{"e1", " ", "=", " ",
        RowBox[{"Normalize", "[",
         RowBox[{"Cross", "[",
          RowBox[{"seed", ",", " ", "d"}], "]"}], "]"}]}], ";", "\n", "  ",
       RowBox[{"e2", " ", "=", " ",
        RowBox[{"Normalize", "[",
         RowBox[{"Cross", "[",
          RowBox[{"d", ",", " ", "e1"}], "]"}], "]"}]}], ";", "\n", "  ",
       RowBox[{"{",
        RowBox[{"e1", ",", " ", "e2"}], "}"}]}]}], "\n", "]"}]}], ";"}],
  "\n"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"dHat", " ", "=", " ",
    RowBox[{"Normalize", "[",
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", "0.9998083395337771"}], ",", " ",
       RowBox[{"-", "0.008522194275992021"}], ",", "\n", "    ",
       "0.017625447609452918"}], "}"}], "]"}]}], ";"}], "\n"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"{",
    RowBox[{"e1Hat", ",", " ", "e2Hat"}], "}"}], " ", "=", " ",
   RowBox[{"makeTransverseBasis", "[", "dHat", "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"pPerp", " ", "=", " ",
   RowBox[{
    RowBox[{"IdentityMatrix", "[", "3", "]"}], " ", "-", " ",
    RowBox[{"Outer", "[",
     RowBox[{"Times", ",", " ", "dHat", ",", " ", "dHat"}], "]"}]}]}],
  ";"}]}], "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"969da9bc-85c2-491a-acd2-242cbf10e7a8"],

Cell["The local unit normal at transverse position q is", "Text",ExpressionUUID->"d7176d1e-24d8-4b39-b9f3-c40ae3072d54"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"nHat", "(", "q", ")"}], "=",
   FractionBox[
    RowBox[{"dHat", "-", "g", "-",
     RowBox[{"lambda", " ",
      RowBox[{"(",
       RowBox[{"cHat", ".", "q"}], ")"}], "cHat"}]}],
    RowBox[{"||",
     RowBox[{"dHat", "-", "g", "-",
      RowBox[{"lambda", " ",
       RowBox[{"(",
        RowBox[{"cHat", ".", "q"}], ")"}], "cHat"}]}], "||"}]]}],
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"6ecf7255-88a2-4076-\
a343-d2cd489f5fcc"],

Cell["\<\
The local normal component of the translating front velocity is\
\>", "Text",ExpressionUUID->"ea181610-f60a-4542-aedc-916d6d4b179e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"vShockNormal", "(", "q", ")"}], "=",
   RowBox[{"nu", " ", "dHat", ".",
    RowBox[{"nHat", "(", "q", ")"}]}]}], TraditionalForm]], "DisplayFormula",E\
xpressionUUID->"c4246b49-a697-4b02-a0a1-0a8d742b5c8c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interactive geometry", "Section",ExpressionUUID->"e800930e-1af8-4ddb-bcc4-29ca162a92d0"],

Cell["\<\
The blue surface is the parabolic-cylinder patch. The translucent gray \
surface is its tangent plane at the reference point. The arrows show the \
propagation direction, local normal, curved tangent direction, and actual \
straight cylinder-axis direction.\
\>", "Text",ExpressionUUID->"8ec0eb72-5e12-4718-a217-70cbe4aa180f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\n", " ",
  RowBox[{
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
      "gVec", ",", " ", "cHatLocal", ",", " ", "aPerp", ",", " ", "origin", ",",
        " ", "qVec", ",", " ", "surfacePoint", ",", "\n", "   ", "planePoint",
        ",", " ", "normal", ",", " ", "curvedTangent", ",", " ",
       "cylinderAxis", ",", " ", "arrowScale"}], "}"}], ",", "\n", "\n", "  ",
     RowBox[{
      RowBox[{"gVec", " ", "=", " ",
       RowBox[{
        RowBox[{"alpha", " ", "e1Hat"}], " ", "+", " ",
        RowBox[{"beta", " ", "e2Hat"}]}]}], ";", "\n", "  ",
      RowBox[{"cHatLocal", " ", "=", " ",
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "psi", "]"}], " ", "e1Hat"}], " ", "+", " ",
        RowBox[{
         RowBox[{"Sin", "[", "psi", "]"}], " ", "e2Hat"}]}]}], ";", "\n",
      "  ",
      RowBox[{"aPerp", " ", "=", " ",
       RowBox[{"Normalize", "[",
        RowBox[{"Cross", "[",
         RowBox[{"dHat", ",", " ", "cHatLocal"}], "]"}], "]"}]}], ";", "\n",
      "  ",
      RowBox[{"origin", " ", "=", " ",
       RowBox[{"nu", " ", "tau", " ", "dHat"}]}], ";", "\n", "\n", "  ",
      RowBox[{
       RowBox[{"qVec", "[",
        RowBox[{"u_", ",", " ", "v_"}], "]"}], " ", ":=", " ",
       RowBox[{
        RowBox[{"u", " ", "e1Hat"}], " ", "+", " ",
        RowBox[{"v", " ", "e2Hat"}]}]}], ";", "\n", "\n", "  ",
      RowBox[{
       RowBox[{"surfacePoint", "[",
        RowBox[{"u_", ",", " ", "v_"}], "]"}], " ", ":=", "\n", "   ",
       RowBox[{
        RowBox[{"qVec", "[",
         RowBox[{"u", ",", " ", "v"}], "]"}], " ", "+", "\n", "    ",
        RowBox[{
         RowBox[{"(",
          RowBox[{
           RowBox[{"nu", " ", "tau"}], " ", "+", " ",
           RowBox[{"gVec", " ", ".", " ",
            RowBox[{"qVec", "[",
             RowBox[{"u", ",", " ", "v"}], "]"}]}], " ", "+", "\n", "      ",

           RowBox[{
            RowBox[{"lambda", "/", "2"}], " ",
            RowBox[{
             RowBox[{"(",
              RowBox[{"cHatLocal", " ", ".", " ",
               RowBox[{"qVec", "[",
                RowBox[{"u", ",", " ", "v"}], "]"}]}], ")"}], "^", "2"}]}]}],
          ")"}], " ", "dHat"}]}]}], ";", "\n", "\n", "  ",
      RowBox[{
       RowBox[{"planePoint", "[",
        RowBox[{"u_", ",", " ", "v_"}], "]"}], " ", ":=", "\n", "   ",
       RowBox[{
        RowBox[{"qVec", "[",
         RowBox[{"u", ",", " ", "v"}], "]"}], " ", "+", " ",
        RowBox[{
         RowBox[{"(",
          RowBox[{
           RowBox[{"nu", " ", "tau"}], " ", "+", " ",
           RowBox[{"gVec", " ", ".", " ",
            RowBox[{"qVec", "[",
             RowBox[{"u", ",", " ", "v"}], "]"}]}]}], ")"}], " ",
         "dHat"}]}]}], ";", "\n", "\n", "  ",
      RowBox[{"normal", " ", "=", " ",
       RowBox[{"Normalize", "[",
        RowBox[{"dHat", " ", "-", " ", "gVec"}], "]"}]}], ";", "\n", "  ",
      RowBox[{"curvedTangent", " ", "=", " ",
       RowBox[{"Normalize", "[",
        RowBox[{"cHatLocal", " ", "+", " ",
         RowBox[{
          RowBox[{"(",
           RowBox[{"gVec", " ", ".", " ", "cHatLocal"}], ")"}], " ",
          "dHat"}]}], "]"}]}], ";", "\n", "  ",
      RowBox[{"cylinderAxis", " ", "=", " ",
       RowBox[{"Normalize", "[",
        RowBox[{"aPerp", " ", "+", " ",
         RowBox[{
          RowBox[{"(",
           RowBox[{"gVec", " ", ".", " ", "aPerp"}], ")"}], " ", "dHat"}]}],
        "]"}]}], ";", "\n", "  ",
      RowBox[{"arrowScale", " ", "=", " ",
       RowBox[{"0.45", " ", "extent"}]}], ";", "\n", "\n", "  ",
      RowBox[{"Show", "[", "\n", "   ",
       RowBox[{
        RowBox[{"ParametricPlot3D", "[", "\n", "    ",
         RowBox[{
          RowBox[{"Evaluate", "[",
           RowBox[{"surfacePoint", "[",
            RowBox[{"u", ",", " ", "v"}], "]"}], "]"}], ",", "\n", "    ",
          RowBox[{"{",
           RowBox[{"u", ",", " ",
            RowBox[{"-", "extent"}], ",", " ", "extent"}], "}"}], ",", " ",
          RowBox[{"{",
           RowBox[{"v", ",", " ",
            RowBox[{"-", "extent"}], ",", " ", "extent"}], "}"}], ",", "\n",
          "    ",
          RowBox[{"Mesh", " ", "->", " ",
           RowBox[{"{",
            RowBox[{"9", ",", " ", "9"}], "}"}]}], ",", "\n", "    ",
          RowBox[{"MeshStyle", " ", "->", " ",
           RowBox[{"Directive", "[",
            RowBox[{
             RowBox[{"GrayLevel", "[", "0.25", "]"}], ",", " ",
             RowBox[{"Opacity", "[", "0.45", "]"}]}], "]"}]}], ",", "\n",
          "    ",
          RowBox[{"PlotStyle", " ", "->", " ",
           RowBox[{"Directive", "[",
