               "Red", ",", " ", "Bold"}], "]"}], ",", "\n", "      ",
             RowBox[{"origin", " ", "+", " ",
              RowBox[{"1.12", " ", "arrowScale", " ", "dHat"}]}]}], "]"}], ",",
            "\n", "\n", "     ", "Black", ",", " ",
           RowBox[{"Arrow", "[",
            RowBox[{"{",
             RowBox[{"origin", ",", " ",
              RowBox[{"origin", " ", "+", " ",
