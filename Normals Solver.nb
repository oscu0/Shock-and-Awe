Cell[CellGroupData[{
Cell["Solver Functions", "Section"],
Cell["Pass each solver an association with \"positionsRE\", \"relativeTimesSeconds\", and \"propagationDirectionGSE\". Positions are GSE coordinates in R_E; times are seconds after the first crossing.", "Text"],
Cell[BoxData["ClearAll[normalInputQ];\nnormalInputQ[data_Association, positionCount_Integer, timeCount_Integer] :=\n Module[{positions, relativeTimes, direction, times},\n  positions = Lookup[data, \"positionsRE\", Missing[\"positionsRE\"]];\n  relativeTimes = Lookup[data, \"relativeTimesSeconds\", Missing[\"relativeTimesSeconds\"]];\n  direction = Lookup[data, \"propagationDirectionGSE\", Missing[\"propagationDirectionGSE\"]];\n  times = Prepend[N[relativeTimes], 0.];\n  Dimensions[positions] === {positionCount, 3} && MatrixQ[positions, NumericQ] &&\n   Length[relativeTimes] === timeCount && VectorQ[relativeTimes, NumericQ] &&\n   AllTrue[Differences[times], # > 0 &] && Length[direction] === 3 &&\n   VectorQ[direction, NumericQ] && Norm[N[direction]] > 0\n ]"], "Input", InitializationCell -> True],
Cell[BoxData["ClearAll[solvePlanarShock];\nsolvePlanarShock::params = \"Expected four GSE position vectors in R_E, three positive relative crossing times in seconds, and a nonzero GSE propagation vector.\";\nsolvePlanarShock::degenerate = \"The four crossings do not define a unique moving plane.\";\nsolvePlanarShock[data_Association] :=\n Module[{positions, times, direction, displacements, denominator, speed,\n   correctedDisplacements, normal, residuals},\n  If[! normalInputQ[data, 4, 3], Message[solvePlanarShock::params]; Return[$Failed]];\n  positions = N[data[\"positionsRE\"]];\n  times = Prepend[N[data[\"relativeTimesSeconds\"]], 0.];\n  direction = Normalize[N[data[\"propagationDirectionGSE\"]]];\n  displacements = (# - First[positions] &) /@ positions[[2 ;; 4]];\n  denominator = Sum[times[[i + 1]] Det[ReplacePart[displacements, i -> direction]], {i, 3}];\n  If[Abs[denominator] < 1/10^12, Message[solvePlanarShock::degenerate]; Return[$Failed]];\n  speed = Det[displacements]/denominator;\n  correctedDisplacements = MapThread[#1 - speed #2 direction &, {displacements, times[[2 ;; 4]]}];\n  normal = Normalize[Cross[correctedDisplacements[[1]], correctedDisplacements[[2]]]];\n  If[normal . direction < 0, normal = -normal];\n  residuals = Abs[correctedDisplacements . normal];\n  <|\"speedREPerSecond\" -> N[speed], \"speedKmPerSecond\" -> N[6378. speed],\n    \"normalGSE\" -> N[normal], \"planeOffsetRE\" -> N[normal . First[positions]],\n    \"maxResidualRE\" -> N[Max[residuals]]|>\n ]"], "Input", InitializationCell -> True],
Cell[BoxData["ClearAll[solveSphericalShock];\nsolveSphericalShock::params = \"Expected five GSE position vectors in R_E, four positive relative crossing times in seconds, and a nonzero GSE propagation vector.\";\nsolveSphericalShock::branch = \"Expected one positive, subluminal, front-facing real spherical solution; found `1`.\";\nsolveSphericalShock[data_Association] :=\n Module[{positions, times, direction, centerX, centerY, centerZ, centerVector,\n   speed, speedValue, equations, solutions, physicalSolutions, solution,\n   centerValue, sigma, normal, residuals},\n  If[! normalInputQ[data, 5, 4], Message[solveSphericalShock::params]; Return[$Failed]];\n  positions = N[data[\"positionsRE\"]];\n  times = Prepend[N[data[\"relativeTimesSeconds\"]], 0.];\n  direction = Normalize[N[data[\"propagationDirectionGSE\"]]];\n  centerVector = {centerX, centerY, centerZ};\n  equations = Table[\n    Total[(positions[[i]] - centerVector - speed times[[i]] direction)^2] ==\n     Total[(First[positions] - centerVector)^2], {i, 2, 5}];\n  solutions = NSolve[equations, {centerX, centerY, centerZ, speed}, Reals];\n  physicalSolutions = Select[solutions, TrueQ[0 < (speed /. #) < 299792.458/6378.] &];\n  physicalSolutions = Select[physicalSolutions,\n    Function[solutionCandidate,\n     With[{candidateCenter = N[centerVector /. solutionCandidate],\n       candidateSpeed = N[speed /. solutionCandidate]},\n      With[{referenceDot = (First[positions] - candidateCenter) . direction},\n       AllTrue[Table[(positions[[i]] - candidateCenter - candidateSpeed times[[i]] direction) . direction,\n         {i, 2, 5}], referenceDot # > 0 &]]]]];\n  If[Length[physicalSolutions] =!= 1,\n   Message[solveSphericalShock::branch, Length[physicalSolutions]]; Return[$Failed]];\n  solution = First[physicalSolutions];\n  centerValue = N[centerVector /. solution];\n  speedValue = N[speed /. solution];\n  sigma = N[Total[(First[positions] - centerValue)^2]];\n  normal = Normalize[First[positions] - centerValue];\n  If[normal . direction < 0, normal = -normal];\n  residuals = Abs[Table[\n     Total[(positions[[i]] - centerValue - speedValue times[[i]] direction)^2] - sigma,\n     {i, 5}]];\n  <|\"speedREPerSecond\" -> speedValue, \"speedKmPerSecond\" -> N[6378. speedValue],\n    \"centerAtReferenceRE\" -> centerValue, \"sigmaRE2\" -> sigma,\n    \"radiusRE\" -> N[Sqrt[sigma]], \"normalGSE\" -> N[normal],\n    \"maxSquaredDistanceResidualRE2\" -> N[Max[residuals]]|>\n ]"], "Input", InitializationCell -> True],
Cell[BoxData["ClearAll[solveShockNormals];\nsolveShockNormals::params = \"Expected an association containing planar and spherical parameter associations.\";\nsolveShockNormals[params_Association] :=\n Module[{planarParameters, sphericalParameters},\n  planarParameters = Lookup[params, \"planar\", Missing[\"planar\"]];\n  sphericalParameters = Lookup[params, \"spherical\", Missing[\"spherical\"]];\n  If[! AssociationQ[planarParameters] || ! AssociationQ[sphericalParameters],\n   Message[solveShockNormals::params]; Return[$Failed]];\n  <|\"planar\" -> solvePlanarShock[planarParameters],\n    \"spherical\" -> solveSphericalShock[sphericalParameters]|>\n ]"], "Input", InitializationCell -> True]
}, Open]]
},
