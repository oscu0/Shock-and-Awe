Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "solveShockNormals", "]"}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"solveShockNormals", "::", "params"}], " ", "=",
   " ", "\"\<Expected an association containing planar and spherical \
parameter associations.\>\""}], ";"}], "\n",
 RowBox[{
  RowBox[{"solveShockNormals", "[", "params_Association", "]"}], " ", ":=",
  "\n", " ",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"planarParameters", ",", " ", "sphericalParameters"}], "}"}], ",",
     "\n", "  ",
    RowBox[{
     RowBox[{"planarParameters", " ", "=", " ",
      RowBox[{"Lookup", "[",
       RowBox[{"params", ",", " ", "\"\<planar\>\"", ",", " ",
        RowBox[{"Missing", "[", "\"\<planar\>\"", "]"}]}], "]"}]}], ";", "\n",
      "  ",
     RowBox[{"sphericalParameters", " ", "=", " ",
      RowBox[{"Lookup", "[",
       RowBox[{"params", ",", " ", "\"\<spherical\>\"", ",", " ",
        RowBox[{"Missing", "[", "\"\<spherical\>\"", "]"}]}], "]"}]}], ";",
     "\n", "  ",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"!", " ",
         RowBox[{"AssociationQ", "[", "planarParameters", "]"}]}], " ", "||",
        " ",
        RowBox[{"!", " ",
         RowBox[{"AssociationQ", "[", "sphericalParameters", "]"}]}]}], ",",
       "\n", "   ",
       RowBox[{
        RowBox[{"Message", "[",
         RowBox[{"solveShockNormals", "::", "params"}], "]"}], ";", " ",
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", "\n", "  ",
     RowBox[{"<|",
      RowBox[{
       RowBox[{"\"\<planar\>\"", " ", "->", " ",
        RowBox[{"solvePlanarShock", "[", "planarParameters", "]"}]}], ",",
       "\n", "    ",
       RowBox[{"\"\<spherical\>\"", " ", "->", " ",
        RowBox[{"solveSphericalShock", "[", "sphericalParameters", "]"}]}]}],
      "|>"}]}]}], "\n", " ", "]"}]}]}], "Input",
 InitializationCell->True,
 CellLabel->"In[40]:=",ExpressionUUID->"83a5d810-20b7-4a8c-856a-e9b8900a9fb1"]
