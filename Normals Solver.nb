Cell[CellGroupData[{

Cell["Solver Functions", "Section",ExpressionUUID->"57185f42-d3d2-44b4-96de-d04ffabfa282"],

Cell["\<\
Pass each solver an association with \"positionsRE\", \
\"relativeTimesSeconds\", and \"propagationDirectionGSE\". Positions are GSE \
coordinates in R_E; times are seconds after the first crossing.\
\>", "Text",ExpressionUUID->"775b4c2e-dd18-49de-ba00-35ed3f903a3f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "normalInputQ", "]"}], ";"}], "\n",
 RowBox[{
  RowBox[{"normalInputQ", "[",
   RowBox[{
   "data_Association", ",", " ", "positionCount_Integer", ",", " ",
    "timeCount_Integer"}], "]"}], " ", ":=", "\n", " ",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
     "positions", ",", " ", "relativeTimes", ",", " ", "direction", ",", " ",
      "times"}], "}"}], ",", "\n", "  ",
    RowBox[{
     RowBox[{"positions", " ", "=", " ",
      RowBox[{"Lookup", "[",
       RowBox[{"data", ",", " ", "\"\<positionsRE\>\"", ",", " ",
        RowBox[{"Missing", "[", "\"\<positionsRE\>\"", "]"}]}], "]"}]}], ";",
     "\n", "  ",
     RowBox[{"relativeTimes", " ", "=", " ",
      RowBox[{"Lookup", "[",
       RowBox[{"data", ",", " ", "\"\<relativeTimesSeconds\>\"", ",", " ",
        RowBox[{"Missing", "[", "\"\<relativeTimesSeconds\>\"", "]"}]}],
       "]"}]}], ";", "\n", "  ",
     RowBox[{"direction", " ", "=", " ",
      RowBox[{"Lookup", "[",
       RowBox[{
       "data", ",", " ", "\"\<propagationDirectionGSE\>\"", ",", " ",
        RowBox[{"Missing", "[", "\"\<propagationDirectionGSE\>\"", "]"}]}],
       "]"}]}], ";", "\n", "  ",
     RowBox[{"times", " ", "=", " ",
      RowBox[{"Prepend", "[",
       RowBox[{
        RowBox[{"N", "[", "relativeTimes", "]"}], ",", " ", "0."}], "]"}]}], ";",
      "\n", "  ",
     RowBox[{
      RowBox[{
       RowBox[{"Dimensions", "[", "positions", "]"}], " ", "===", " ",
       RowBox[{"{",
        RowBox[{"positionCount", ",", " ", "3"}], "}"}]}], " ", "&&", " ",
      RowBox[{"MatrixQ", "[",
       RowBox[{"positions", ",", " ", "NumericQ"}], "]"}], " ", "&&", "\n",
      "   ",
      RowBox[{
       RowBox[{"Length", "[", "relativeTimes", "]"}], " ", "===", " ",
       "timeCount"}], " ", "&&", " ",
      RowBox[{"VectorQ", "[",
       RowBox[{"relativeTimes", ",", " ", "NumericQ"}], "]"}], " ", "&&",
      "\n", "   ",
      RowBox[{"AllTrue", "[",
       RowBox[{
        RowBox[{"Differences", "[", "times", "]"}], ",", " ",
        RowBox[{
         RowBox[{"#", " ", ">=", " ", "0"}], " ", "&"}]}], "]"}], " ", "&&",
      " ",
      RowBox[{
       RowBox[{"Length", "[", "direction", "]"}], " ", "===", " ", "3"}], " ",
       "&&", "\n", "   ",
      RowBox[{"VectorQ", "[",
       RowBox[{"direction", ",", " ", "NumericQ"}], "]"}], " ", "&&", " ",
      RowBox[{
       RowBox[{"Norm", "[",
        RowBox[{"N", "[", "direction", "]"}], "]"}], " ", ">", " ",
       "0"}]}]}]}], "\n", " ", "]"}]}]}], "Input",
 InitializationCell->True,
 CellLabel->"In[30]:=",ExpressionUUID->"6d97496a-e753-433d-9ebb-e40c890b1625"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "solvePlanarShock", "]"}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"solvePlanarShock", "::", "params"}], " ", "=",
   " ", "\"\<Expected four GSE position vectors in R_E, three nonnegative \
ordered relative crossing times in seconds, and a nonzero GSE propagation \
vector.\>\""}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"solvePlanarShock", "::", "degenerate"}], " ", "=",
   " ", "\"\<The four crossings do not define a unique moving plane.\>\""}],
  ";"}], "\n",
 RowBox[{
  RowBox[{"solvePlanarShock", "[", "data_Association", "]"}], " ", ":=", "\n",
   " ",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
     "positions", ",", " ", "times", ",", " ", "direction", ",", " ",
      "displacements", ",", " ", "denominator", ",", " ", "speed", ",", "\n",
      "   ", "correctedDisplacements", ",", " ", "normal", ",", " ",
      "residuals"}], "}"}], ",", "\n", "  ",
    RowBox[{
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{"!", " ",
        RowBox[{"normalInputQ", "[",
         RowBox[{"data", ",", " ", "4", ",", " ", "3"}], "]"}]}], ",", " ",
       RowBox[{
        RowBox[{"Message", "[",
         RowBox[{"solvePlanarShock", "::", "params"}], "]"}], ";", " ",
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", "\n", "  ",
     RowBox[{"positions", " ", "=", " ",
      RowBox[{"N", "[",
       RowBox[{"data", "[", "\"\<positionsRE\>\"", "]"}], "]"}]}], ";", "\n",
     "  ",
     RowBox[{"times", " ", "=", " ",
      RowBox[{"Prepend", "[",
       RowBox[{
        RowBox[{"N", "[",
         RowBox[{"data", "[", "\"\<relativeTimesSeconds\>\"", "]"}], "]"}], ",",
         " ", "0."}], "]"}]}], ";", "\n", "  ",
     RowBox[{"direction", " ", "=", " ",
      RowBox[{"Normalize", "[",
       RowBox[{"N", "[",
        RowBox[{"data", "[", "\"\<propagationDirectionGSE\>\"", "]"}], "]"}],
       "]"}]}], ";", "\n", "  ",
     RowBox[{"displacements", " ", "=", " ",
      RowBox[{
       RowBox[{"(",
        RowBox[{
         RowBox[{"#", " ", "-", " ",
          RowBox[{"First", "[", "positions", "]"}]}], " ", "&"}], ")"}], " ",
       "/@", " ",
       RowBox[{"positions", "[",
        RowBox[{"[",
         RowBox[{"2", " ", ";;", " ", "4"}], "]"}], "]"}]}]}], ";", "\n",
     "  ",
     RowBox[{"denominator", " ", "=", " ",
      RowBox[{"Sum", "[",
       RowBox[{
        RowBox[{
         RowBox[{"times", "[",
          RowBox[{"[",
           RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ",
         RowBox[{"Det", "[",
          RowBox[{"ReplacePart", "[",
           RowBox[{"displacements", ",", " ",
            RowBox[{"i", " ", "->", " ", "direction"}]}], "]"}], "]"}]}], ",",
         " ",
        RowBox[{"{",
         RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";", "\n", "  ",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "denominator", "]"}], " ", "<", " ",
        RowBox[{"1", "/",
         RowBox[{"10", "^", "12"}]}]}], ",", " ",
       RowBox[{
        RowBox[{"Message", "[",
         RowBox[{"solvePlanarShock", "::", "degenerate"}], "]"}], ";", " ",
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", "\n", "  ",
     RowBox[{"speed", " ", "=", " ",
      RowBox[{
       RowBox[{"Det", "[", "displacements", "]"}], "/", "denominator"}]}], ";",
      "\n", "  ",
     RowBox[{"correctedDisplacements", " ", "=", " ",
      RowBox[{"MapThread", "[",
       RowBox[{
        RowBox[{
         RowBox[{"#1", " ", "-", " ",
          RowBox[{"speed", " ", "#2", " ", "direction"}]}], " ", "&"}], ",",
        " ",
        RowBox[{"{",
         RowBox[{"displacements", ",", " ",
          RowBox[{"times", "[",
           RowBox[{"[",
            RowBox[{"2", " ", ";;", " ", "4"}], "]"}], "]"}]}], "}"}]}],
       "]"}]}], ";", "\n", "  ",
     RowBox[{"normal", " ", "=", " ",
      RowBox[{"Normalize", "[",
       RowBox[{"Cross", "[",
        RowBox[{
         RowBox[{"correctedDisplacements", "[",
          RowBox[{"[", "1", "]"}], "]"}], ",", " ",
         RowBox[{"correctedDisplacements", "[",
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], ";", "\n", "  ",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"normal", " ", ".", " ", "direction"}], " ", "<", " ", "0"}],
       ",", " ",
       RowBox[{"normal", " ", "=", " ",
        RowBox[{"-", "normal"}]}]}], "]"}], ";", "\n", "  ",
     RowBox[{"residuals", " ", "=", " ",
      RowBox[{"Abs", "[",
       RowBox[{"correctedDisplacements", " ", ".", " ", "normal"}], "]"}]}], ";",
      "\n", "  ",
     RowBox[{"<|",
      RowBox[{
       RowBox[{"\"\<speedREPerSecond\>\"", " ", "->", " ",
        RowBox[{"N", "[", "speed", "]"}]}], ",", " ",
       RowBox[{"\"\<speedKmPerSecond\>\"", " ", "->", " ",
        RowBox[{"N", "[",
         RowBox[{"6378.", " ", "speed"}], "]"}]}], ",", "\n", "    ",
       RowBox[{"\"\<normalGSE\>\"", " ", "->", " ",
        RowBox[{"N", "[", "normal", "]"}]}], ",", " ",
       RowBox[{"\"\<planeOffsetRE\>\"", " ", "->", " ",
        RowBox[{"N", "[",
         RowBox[{"normal", " ", ".", " ",
          RowBox[{"First", "[", "positions", "]"}]}], "]"}]}], ",", "\n",
       "    ",
       RowBox[{"\"\<maxResidualRE\>\"", " ", "->", " ",
        RowBox[{"N", "[",
         RowBox[{"Max", "[", "residuals", "]"}], "]"}]}]}], "|>"}]}]}], "\n",
   " ", "]"}]}]}], "Input",
 InitializationCell->True,
 CellLabel->"In[32]:=",ExpressionUUID->"7af4b92d-52ba-4f78-879a-12fab8734732"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "solveSphericalShock", "]"}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"solveSphericalShock", "::", "params"}], " ", "=",
   " ", "\"\<Expected five GSE position vectors in R_E, four nonnegative \
ordered relative crossing times in seconds, and a nonzero GSE propagation \
vector.\>\""}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"solveSphericalShock", "::", "branch"}], " ", "=",
   " ", "\"\<Expected one positive, subluminal, front-facing real spherical \
solution; found `1`.\>\""}], ";"}], "\n",
 RowBox[{
  RowBox[{"solveSphericalShock", "[", "data_Association", "]"}], " ", ":=",
  "\n", " ",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
     "positions", ",", " ", "times", ",", " ", "direction", ",", " ",
      "centerX", ",", " ", "centerY", ",", " ", "centerZ", ",", " ",
      "centerVector", ",", "\n", "   ", "speed", ",", " ", "speedValue", ",",
      " ", "equations", ",", " ", "solutions", ",", " ", "physicalSolutions",
      ",", " ", "solution", ",", "\n", "   ", "centerValue", ",", " ",
      "sigma", ",", " ", "normal", ",", " ", "residuals"}], "}"}], ",", "\n",
    "  ",
    RowBox[{
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{"!", " ",
        RowBox[{"normalInputQ", "[",
         RowBox[{"data", ",", " ", "5", ",", " ", "4"}], "]"}]}], ",", " ",
       RowBox[{
        RowBox[{"Message", "[",
         RowBox[{"solveSphericalShock", "::", "params"}], "]"}], ";", " ",
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", "\n", "  ",
     RowBox[{"positions", " ", "=", " ",
      RowBox[{"N", "[",
       RowBox[{"data", "[", "\"\<positionsRE\>\"", "]"}], "]"}]}], ";", "\n",
     "  ",
     RowBox[{"times", " ", "=", " ",
      RowBox[{"Prepend", "[",
       RowBox[{
        RowBox[{"N", "[",
         RowBox[{"data", "[", "\"\<relativeTimesSeconds\>\"", "]"}], "]"}], ",",
         " ", "0."}], "]"}]}], ";", "\n", "  ",
     RowBox[{"direction", " ", "=", " ",
      RowBox[{"Normalize", "[",
       RowBox[{"N", "[",
        RowBox[{"data", "[", "\"\<propagationDirectionGSE\>\"", "]"}], "]"}],
       "]"}]}], ";", "\n", "  ",
     RowBox[{"centerVector", " ", "=", " ",
      RowBox[{"{",
       RowBox[{"centerX", ",", " ", "centerY", ",", " ", "centerZ"}], "}"}]}],
      ";", "\n", "  ",
     RowBox[{"equations", " ", "=", " ",
      RowBox[{"Table", "[", "\n", "    ",
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[",
          RowBox[{
           RowBox[{"(",
            RowBox[{
             RowBox[{"positions", "[",
              RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", "centerVector",
             " ", "-", " ",
             RowBox[{"speed", " ",
              RowBox[{"times", "[",
               RowBox[{"[", "i", "]"}], "]"}], " ", "direction"}]}], ")"}], "^",
            "2"}], "]"}], " ", "==", "\n", "     ",
         RowBox[{"Total", "[",
          RowBox[{
           RowBox[{"(",
            RowBox[{
             RowBox[{"First", "[", "positions", "]"}], " ", "-", " ",
             "centerVector"}], ")"}], "^", "2"}], "]"}]}], ",", " ",
        RowBox[{"{",
         RowBox[{"i", ",", " ", "2", ",", " ", "5"}], "}"}]}], "]"}]}], ";",
     "\n", "  ",
     RowBox[{"solutions", " ", "=", " ",
      RowBox[{"NSolve", "[",
       RowBox[{"equations", ",", " ",
        RowBox[{"{",
         RowBox[{
         "centerX", ",", " ", "centerY", ",", " ", "centerZ", ",", " ",
          "speed"}], "}"}], ",", " ", "Reals"}], "]"}]}], ";", "\n", "  ",
     RowBox[{"physicalSolutions", " ", "=", " ",
      RowBox[{"Select", "[",
       RowBox[{"solutions", ",", " ",
        RowBox[{
         RowBox[{"TrueQ", "[",
          RowBox[{"0", " ", "<", " ",
           RowBox[{"(",
            RowBox[{"speed", " ", "/.", " ", "#"}], ")"}], " ", "<", " ",
           RowBox[{"299792.458", "/", "6378."}]}], "]"}], " ", "&"}]}],
       "]"}]}], ";", "\n", "  ",
     RowBox[{"physicalSolutions", " ", "=", " ",
      RowBox[{"Select", "[",
       RowBox[{"physicalSolutions", ",", "\n", "    ",
        RowBox[{"Function", "[",
         RowBox[{"solutionCandidate", ",", "\n", "     ",
          RowBox[{"With", "[",
           RowBox[{
            RowBox[{"{",
             RowBox[{
              RowBox[{"candidateCenter", " ", "=", " ",
               RowBox[{"N", "[",
                RowBox[{"centerVector", " ", "/.", " ", "solutionCandidate"}],
                 "]"}]}], ",", "\n", "       ",
              RowBox[{"candidateSpeed", " ", "=", " ",
               RowBox[{"N", "[",
                RowBox[{"speed", " ", "/.", " ", "solutionCandidate"}],
                "]"}]}]}], "}"}], ",", "\n", "      ",
            RowBox[{"With", "[",
             RowBox[{
              RowBox[{"{",
               RowBox[{"referenceDot", " ", "=", " ",
                RowBox[{
                 RowBox[{"(",
                  RowBox[{
                   RowBox[{"First", "[", "positions", "]"}], " ", "-", " ",
                   "candidateCenter"}], ")"}], " ", ".", " ", "direction"}]}],
                "}"}], ",", "\n", "       ",
              RowBox[{"AllTrue", "[",
               RowBox[{
                RowBox[{"Table", "[",
                 RowBox[{
                  RowBox[{
                   RowBox[{"(",
                    RowBox[{
                    RowBox[{"positions", "[",
                    RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ",
                    "candidateCenter", " ", "-", " ",
                    RowBox[{"candidateSpeed", " ",
                    RowBox[{"times", "[",
                    RowBox[{"[", "i", "]"}], "]"}], " ", "direction"}]}],
                    ")"}], " ", ".", " ", "direction"}], ",", "\n",
                  "         ",
                  RowBox[{"{",
                   RowBox[{"i", ",", " ", "2", ",", " ", "5"}], "}"}]}],
                 "]"}], ",", " ",
                RowBox[{
                 RowBox[{
                  RowBox[{"referenceDot", " ", "#"}], " ", ">", " ", "0"}],
                 " ", "&"}]}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], ";",
      "\n", "  ",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "physicalSolutions", "]"}], " ", "=!=", " ",
        "1"}], ",", "\n", "   ",
       RowBox[{
        RowBox[{"Message", "[",
         RowBox[{
          RowBox[{"solveSphericalShock", "::", "branch"}], ",", " ",
          RowBox[{"Length", "[", "physicalSolutions", "]"}]}], "]"}], ";",
        " ",
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", "\n", "  ",
     RowBox[{"solution", " ", "=", " ",
      RowBox[{"First", "[", "physicalSolutions", "]"}]}], ";", "\n", "  ",
     RowBox[{"centerValue", " ", "=", " ",
      RowBox[{"N", "[",
       RowBox[{"centerVector", " ", "/.", " ", "solution"}], "]"}]}], ";",
     "\n", "  ",
     RowBox[{"speedValue", " ", "=", " ",
      RowBox[{"N", "[",
       RowBox[{"speed", " ", "/.", " ", "solution"}], "]"}]}], ";", "\n",
     "  ",
     RowBox[{"sigma", " ", "=", " ",
      RowBox[{"N", "[",
       RowBox[{"Total", "[",
        RowBox[{
         RowBox[{"(",
          RowBox[{
           RowBox[{"First", "[", "positions", "]"}], " ", "-", " ",
           "centerValue"}], ")"}], "^", "2"}], "]"}], "]"}]}], ";", "\n",
     "  ",
     RowBox[{"normal", " ", "=", " ",
      RowBox[{"Normalize", "[",
       RowBox[{
        RowBox[{"First", "[", "positions", "]"}], " ", "-", " ",
        "centerValue"}], "]"}]}], ";", "\n", "  ",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"normal", " ", ".", " ", "direction"}], " ", "<", " ", "0"}],
       ",", " ",
       RowBox[{"normal", " ", "=", " ",
        RowBox[{"-", "normal"}]}]}], "]"}], ";", "\n", "  ",
     RowBox[{"residuals", " ", "=", " ",
      RowBox[{"Abs", "[",
       RowBox[{"Table", "[", "\n", "     ",
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[",
           RowBox[{
            RowBox[{"(",
             RowBox[{
              RowBox[{"positions", "[",
               RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", "centerValue",
              " ", "-", " ",
              RowBox[{"speedValue", " ",
               RowBox[{"times", "[",
                RowBox[{"[", "i", "]"}], "]"}], " ", "direction"}]}], ")"}], "^",
