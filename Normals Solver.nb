    ";",
   RowBox[{"Save", "[",
    RowBox[{
     RowBox[{"FileNameJoin", "[",
      RowBox[{"{",
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}],
        ",", "\"\<nu solution.wl\>\""}], "}"}], "]"}], ",", "s\[Nu]"}],
    "]"}]}], "*)"}]], "Input",
